{
  "env": {
    "GRAPHIFY_BACKEND": "none"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/home/s/.local/bin/graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/home/s/.local/bin/graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "/home/s/.local/bin/graphify hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
