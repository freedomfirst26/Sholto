<Project Sdk="Microsoft.NET.Sdk">

  <!-- OS gates for tests (LinuxOnlyFact/LinuxOnlyTheory); references nothing but xunit's extensibility core, so any test project can use it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Sholto.TestSupport.Platform</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.extensibility.core" Version="2.9.3" />
  </ItemGroup>

</Project>
