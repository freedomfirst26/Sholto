  <Color x:Key="Flx4Tone5A5E64Color">#5A5E64</Color>
  <SolidColorBrush x:Key="Flx4Tone5A5E64" Color="{StaticResource Flx4Tone5A5E64Color}"/>
  <Color x:Key="Flx4Tone8E939AColor">#8E939A</Color>
  <Color x:Key="Flx4Tone4A4E55Color">#4A4E55</Color>
