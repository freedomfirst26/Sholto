<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Pioneer DDJ-FLX4 hardware palette. Fixed, not themed: a graphite deck is graphite
       in every theme. Each colour appears once; Flx4<Name>Color is the Color (gradient
       stops), Flx4<Name> the SolidColorBrush (Fill, Stroke, Background). Names marked
       Tone<hex> paint unrelated parts and are named by value. -->

  <Color x:Key="Flx4ShadowColor">#000000</Color>  <!-- drop shadows and recess wells -->
  <SolidColorBrush x:Key="Flx4Shadow" Color="{StaticResource Flx4ShadowColor}"/>
  <Color x:Key="Flx4HighlightColor">#FFFFFF</Color>  <!-- specular lips on dimples and bevels -->
  <SolidColorBrush x:Key="Flx4Highlight" Color="{StaticResource Flx4HighlightColor}"/>
  <Color x:Key="Flx4LabelInkColor">#D6DAE0</Color>  <!-- primary silk-screen text -->
  <SolidColorBrush x:Key="Flx4LabelInk" Color="{StaticResource Flx4LabelInkColor}"/>
  <Color x:Key="Flx4LabelInkDimColor">#9AA0A8</Color>  <!-- secondary scale text (-26, +6, MIN/MAX) -->
  <SolidColorBrush x:Key="Flx4LabelInkDim" Color="{StaticResource Flx4LabelInkDimColor}"/>
  <Color x:Key="Flx4LegendInkColor">#B9BDC4</Color>  <!-- text inside an outlined shift legend -->
  <SolidColorBrush x:Key="Flx4LegendInk" Color="{StaticResource Flx4LegendInkColor}"/>
  <Color x:Key="Flx4LegendFillColor">#1A1C1F</Color>  <!-- outlined legend box interior -->
  <SolidColorBrush x:Key="Flx4LegendFill" Color="{StaticResource Flx4LegendFillColor}"/>
  <Color x:Key="Flx4LegendEdgeColor">#7B7F86</Color>  <!-- outlined legend box border -->
  <SolidColorBrush x:Key="Flx4LegendEdge" Color="{StaticResource Flx4LegendEdgeColor}"/>
  <Color x:Key="Flx4AccentInkColor">#E8963C</Color>  <!-- orange silk-screen text -->
  <SolidColorBrush x:Key="Flx4AccentInk" Color="{StaticResource Flx4AccentInkColor}"/>
  <Color x:Key="Flx4AccentLitColor">#F0A24E</Color>  <!-- lit orange button lettering -->
  <SolidColorBrush x:Key="Flx4AccentLit" Color="{StaticResource Flx4AccentLitColor}"/>
  <Color x:Key="Flx4AccentEdgeColor">#C2661D</Color>  <!-- lit orange edge on pads and mode buttons -->
  <SolidColorBrush x:Key="Flx4AccentEdge" Color="{StaticResource Flx4AccentEdgeColor}"/>
  <Color x:Key="Flx4JogTickColor">#D3D8DE</Color>  <!-- the fine tick ring on the platter -->
  <SolidColorBrush x:Key="Flx4JogTick" Color="{StaticResource Flx4JogTickColor}"/>
  <Color x:Key="Flx4ScaleTickColor">#8F949B</Color>  <!-- fader scale ticks -->
  <SolidColorBrush x:Key="Flx4ScaleTick" Color="{StaticResource Flx4ScaleTickColor}"/>
  <Color x:Key="Flx4PointerInkColor">#DCE0E6</Color>  <!-- knob pointer line -->
  <SolidColorBrush x:Key="Flx4PointerInk" Color="{StaticResource Flx4PointerInkColor}"/>
  <Color x:Key="Flx4EdgeBlackColor">#0C0D0F</Color>  <!-- hardest body seam -->
  <Color x:Key="Flx4EdgeDarkColor">#0D0E10</Color>  <!-- cap and knob outlines -->
  <SolidColorBrush x:Key="Flx4EdgeDark" Color="{StaticResource Flx4EdgeDarkColor}"/>
  <Color x:Key="Flx4EdgeDarkAltColor">#0E0F11</Color>  <!-- knob cap outline -->
  <SolidColorBrush x:Key="Flx4EdgeDarkAlt" Color="{StaticResource Flx4EdgeDarkAltColor}"/>
  <Color x:Key="Flx4RimLightColor">#96999F</Color>  <!-- lit side of a knob rim -->
  <Color x:Key="Flx4RimMidColor">#4A4D53</Color>  <!-- knob rim, mid tone -->
  <Color x:Key="Flx4RimDarkColor">#17181B</Color>  <!-- knob rim, shaded side -->
  <Color x:Key="Flx4KnobSkirtLitColor">#63666B</Color>  <!-- knob skirt, lit -->
  <Color x:Key="Flx4KnobSkirtMidColor">#3A3D42</Color>  <!-- knob skirt, mid -->
  <Color x:Key="Flx4KnobSkirtDimColor">#212328</Color>  <!-- knob skirt, shaded -->
  <Color x:Key="Flx4KnobCapLitColor">#5A5D63</Color>  <!-- knob cap, lit -->
  <Color x:Key="Flx4KnobCapMidColor">#2E3136</Color>  <!-- knob cap, mid -->
  <Color x:Key="Flx4KnobCapDimColor">#17181C</Color>  <!-- knob cap, shaded -->
  <Color x:Key="Flx4ButtonTopColor">#4C5057</Color>  <!-- rounded button, lit edge -->
  <Color x:Key="Flx4ButtonFaceColor">#2A2C30</Color>  <!-- accent button face -->
  <Color x:Key="Flx4ButtonFaceDimColor">#171A1D</Color>  <!-- accent button face, shaded -->
  <Color x:Key="Flx4PadWarmColor">#33261B</Color>  <!-- pad rubber, warm lit corner -->
  <Color x:Key="Flx4PadFillColor">#191A1D</Color>  <!-- pad rubber, body -->
  <Color x:Key="Flx4CapDarkColor">#141619</Color>  <!-- fader cap, shaded end -->
  <Color x:Key="Flx4Tone4A4D52Color">#4A4D52</Color>
  <Color x:Key="Flx4Tone3B3E42Color">#3B3E42</Color>
  <Color x:Key="Flx4Tone2C2E32Color">#2C2E32</Color>
  <Color x:Key="Flx4Tone191A1CColor">#191A1C</Color>
  <SolidColorBrush x:Key="Flx4Tone191A1C" Color="{StaticResource Flx4Tone191A1CColor}"/>
