  <Color x:Key="Flx4Tone3A1D04Color">#3A1D04</Color>
  <SolidColorBrush x:Key="Flx4Tone3A1D04" Color="{StaticResource Flx4Tone3A1D04Color}"/>
  <Color x:Key="Flx4Tone5C6066Color">#5C6066</Color>
  <Color x:Key="Flx4Tone33363BColor">#33363B</Color>
