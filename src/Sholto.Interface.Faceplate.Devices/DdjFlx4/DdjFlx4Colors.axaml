  <SolidColorBrush x:Key="Flx4Tone0A0B0C" Color="{StaticResource Flx4Tone0A0B0CColor}"/>
  <Color x:Key="Flx4Tone4C5056Color">#4C5056</Color>
  <Color x:Key="Flx4Tone2A2D31Color">#2A2D31</Color>
