  <Color x:Key="Flx4Tone101114Color">#101114</Color>
  <SolidColorBrush x:Key="Flx4Tone101114" Color="{StaticResource Flx4Tone101114Color}"/>
  <Color x:Key="Flx4Tone7E828AColor">#7E828A</Color>
  <SolidColorBrush x:Key="Flx4Tone7E828A" Color="{StaticResource Flx4Tone7E828AColor}"/>
  <Color x:Key="Flx4Tone8A8E95Color">#8A8E95</Color>
  <Color x:Key="Flx4Tone33363AColor">#33363A</Color>
  <Color x:Key="Flx4Tone101113Color">#101113</Color>
  <SolidColorBrush x:Key="Flx4Tone101113" Color="{StaticResource Flx4Tone101113Color}"/>
  <Color x:Key="Flx4Tone15161AColor">#15161A</Color>
  <SolidColorBrush x:Key="Flx4Tone15161A" Color="{StaticResource Flx4Tone15161AColor}"/>
  <Color x:Key="Flx4ToneFFD3A0Color">#FFD3A0</Color>
  <Color x:Key="Flx4ToneF79A3CColor">#F79A3C</Color>
  <Color x:Key="Flx4ToneD9701CColor">#D9701C</Color>
  <Color x:Key="Flx4Tone9C4A0CColor">#9C4A0C</Color>
  <Color x:Key="Flx4Tone66FFFFFFColor">#66FFFFFF</Color>
