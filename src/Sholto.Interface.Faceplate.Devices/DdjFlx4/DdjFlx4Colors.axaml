  <Color x:Key="Flx4Tone565A60Color">#565A60</Color>
  <Color x:Key="Flx4Tone2B2E33Color">#2B2E33</Color>
  <Color x:Key="Flx4Tone3E4247Color">#3E4247</Color>
  <Color x:Key="Flx4Tone3C4046Color">#3C4046</Color>
