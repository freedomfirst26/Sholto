<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sholto.Interface.MainUI.ViewModels"
             x:Class="Sholto.Interface.MainUI.Views.OutputPickerOverlay"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding IsOutputPickerOpen}"
             Focusable="False">

    <UserControl.Styles>
        <Style Selector="Button.quiet">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SholtoTextMuted}"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.quiet:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SholtoAccentBg}"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource SholtoPrimary}"/>
            <Setter Property="Foreground" Value="{DynamicResource SholtoBgDeep}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter, Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SholtoPrimary}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource SholtoScrim}" PointerPressed="OnBackdropPressed">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="440" MaxHeight="480"
                Background="{DynamicResource SholtoSurfaceRaised}"
                BorderBrush="{DynamicResource SholtoBorder}" BorderThickness="1"
                CornerRadius="10"
                PointerPressed="OnPanelPressed">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                <TextBlock Grid.Row="0" Text="🔊  AUDIO OUTPUT"
                           FontSize="11" FontWeight="Bold" LetterSpacing="1.5"
                           Foreground="{DynamicResource SholtoAccent}"
                           Margin="20,16,20,0"/>
                <TextBlock Grid.Row="1" Text="{Binding OutputPicker.Headline}"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource SholtoTextBright}"
                           TextTrimming="CharacterEllipsis"
                           Margin="20,2,20,2"/>
                <TextBlock Grid.Row="2" Text="{Binding OutputPicker.Subtext}"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource SholtoTextMuted}"
                           Margin="20,0,20,10"/>

                <ScrollViewer Grid.Row="3">
                    <ListBox ItemsSource="{Binding OutputPicker.Devices}"
                             SelectedIndex="{Binding OutputPicker.SelectedIndex, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Focusable="False"
                             DoubleTapped="OnDeviceActivated">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource SholtoAccentBg}"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:OutputDeviceRow">
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,6">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               FontSize="15" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SholtoTextBright}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" CornerRadius="4" Padding="7,1"
                                            Margin="8,0,0,0" VerticalAlignment="Center"
                                            Background="{DynamicResource SholtoBgDeep}"
                                            IsVisible="{Binding IsCurrent}">
                                        <TextBlock Text="IN USE" FontSize="11" FontWeight="Bold" LetterSpacing="1"
                                                   Foreground="{DynamicResource SholtoPrimary}"/>
                                    </Border>
                                    <Border Grid.Column="2" CornerRadius="4" Padding="7,1"
                                            Margin="8,0,0,0" VerticalAlignment="Center"
                                            Background="{DynamicResource SholtoBgDeep}"
                                            IsVisible="{Binding IsDefault}">
                                        <TextBlock Text="SYSTEM DEFAULT" FontSize="11" FontWeight="Bold" LetterSpacing="1"
                                                   Foreground="{DynamicResource SholtoTextMuted}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" Margin="20,8,14,12">
                    <TextBlock Grid.Column="0" Text="↑↓ move · Enter use · Esc cancel"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource SholtoTextMuted}"/>
                    <Button Grid.Column="1" Classes="quiet" Content="Cancel" Click="OnCancelClick"/>
                    <Button Grid.Column="2" Classes="primary" Content="Use device" Margin="8,0,0,0"
                            Click="OnUseClick"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
