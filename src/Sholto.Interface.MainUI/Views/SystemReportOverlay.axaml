<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sholto.Interface.MainUI.ViewModels"
             x:Class="Sholto.Interface.MainUI.Views.SystemReportOverlay"
             x:DataType="vm:ISystemReportViewModel"
             Focusable="False">

    <!-- The tool rows only: ModalShell supplies the scrim, panel, headline, Close button and hint. -->
    <ItemsControl ItemsSource="{Binding Rows}" Margin="-6,0">
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SystemReportRow">
                <Grid ColumnDefinitions="18,*" Margin="6,5">
                    <TextBlock Grid.Column="0" Text="●" FontSize="11"
                               VerticalAlignment="Top" Margin="0,3,0,0"
                               Foreground="{DynamicResource SholtoStatusOk}"
                               IsVisible="{Binding IsPresent}"/>
                    <TextBlock Grid.Column="0" Text="●" FontSize="11"
                               VerticalAlignment="Top" Margin="0,3,0,0"
                               Foreground="{DynamicResource SholtoStatusAttention}"
                               IsVisible="{Binding IsMissing}"/>
                    <StackPanel Grid.Column="1" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Capability}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SholtoTextBright}"/>
                            <TextBlock Text="{Binding ToolName}"
                                       FontSize="13"
                                       Foreground="{DynamicResource SholtoTextMuted}"/>
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource SholtoTextMuted}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SholtoTextMuted}"/>
                        <Border IsVisible="{Binding IsMissing}"
                                CornerRadius="4" Padding="7,2" Margin="0,3,0,0"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource SholtoBgDeep}">
                            <TextBlock Text="{Binding Install}"
                                       FontFamily="monospace" FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SholtoTextBright}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
