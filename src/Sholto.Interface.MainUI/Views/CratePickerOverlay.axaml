<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sholto.Interface.MainUI.ViewModels"
             xmlns:modal="using:Sholto.Interface.MainUI.Controls.Modal"
             x:Class="Sholto.Interface.MainUI.Views.CratePickerOverlay"
             x:DataType="vm:CratePickerViewModel"
             Focusable="False">

    <!-- The query box and the crate list only: ModalShell supplies the scrim, panel, title, buttons and hint.
         Keys are routed from MainWindow (ModalKeyRouter), so the box just types; the shell focuses it on open. -->
    <Grid RowDefinitions="Auto,*">
        <TextBox x:Name="CrateQueryBox" Grid.Row="0"
                 modal:ModalShell.FocusOnOpen="True"
                 Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Watermark="Find or create a crate…"
                 FontSize="18" Padding="20,12" Margin="8,8,8,0"
                 BorderThickness="0" Background="Transparent"
                 Foreground="{DynamicResource SholtoTextBright}"/>

        <ScrollViewer Grid.Row="1">
            <ListBox ItemsSource="{Binding Options}"
                     SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     Focusable="False"
                     DoubleTapped="OnOptionActivated">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource SholtoAccentBg}"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CratePickerOption">
                        <Grid ColumnDefinitions="*,Auto" Margin="12,6">
                            <TextBlock Grid.Column="0" Text="{Binding Display}"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SholtoTextBright}"/>
                            <TextBlock Grid.Column="1" Text="{Binding TrackCount}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SholtoTextMuted}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !IsCreate}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </Grid>
</UserControl>
