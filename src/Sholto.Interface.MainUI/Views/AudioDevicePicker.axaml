<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sholto.Interface.MainUI.Views.AudioDevicePicker"
        Title="Choose Audio Output"
        Width="500" Height="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SholtoBgDeep}"
        CanResize="False">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <TextBlock Grid.Row="0"
                   Text="Select an audio output device:"
                   Foreground="{DynamicResource SholtoTextBright}" FontSize="14"
                   Margin="0,0,0,12"/>

        <ListBox Grid.Row="1"
                 Name="DeviceList"
                 Background="{DynamicResource SholtoSurface}"
                 Foreground="{DynamicResource SholtoTextBright}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SholtoTextBright}"/>
                        <TextBlock Text="default" IsVisible="{Binding IsDefault}"
                                   Foreground="{DynamicResource SholtoAccent}" FontSize="11"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0" Spacing="8">
            <Button Content="Cancel" Click="OnCancel"
                    Background="{DynamicResource SholtoBorder}" Foreground="{DynamicResource SholtoTextBright}" Padding="16,6"/>
            <Button Content="Use this device" Click="OnConfirm"
                    Background="{DynamicResource SholtoPrimary}" Foreground="{DynamicResource SholtoBgDeep}" Padding="16,6" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
