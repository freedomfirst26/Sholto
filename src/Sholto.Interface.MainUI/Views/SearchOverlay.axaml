<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sholto.Interface.MainUI.ViewModels"
             xmlns:data="using:Sholto.Data"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="Sholto.Interface.MainUI.Views.SearchOverlay"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding IsSearchOpen}"
             Focusable="False">

    <!-- Full-screen backdrop dims everything behind the panel. Click anywhere
         outside the panel to close (handler in code-behind). -->
    <Grid Background="{DynamicResource SholtoScrim}" PointerPressed="OnBackdropPressed">

        <!-- Centred panel. 60% of window width, 70% of window height max. -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="720" MaxHeight="600"
                Background="{DynamicResource SholtoSurfaceRaised}"
                BorderBrush="{DynamicResource SholtoBorder}" BorderThickness="1"
                CornerRadius="8" Padding="0"
                PointerPressed="OnPanelPressed">

            <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0">
                <!-- (Row 0 reserved.) The deck-target chooser that used to sit here
                     was removed; the load target is still chosen implicitly by
                     MainViewModel.PickDefaultLoadTarget and toggled with ←/→. -->

                <!-- Search identity: magnifier icon left of the big input. -->
                <TextBlock Grid.Row="1" Text="🔍" FontSize="20"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="20,0,0,0" IsHitTestVisible="False"/>
                <!-- Big search input -->
                <TextBox x:Name="QueryBox"
                         Grid.Row="1"
                         Text="{Binding Search.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Watermark="Search tracks or crates…"
                         FontSize="24" Padding="54,16,20,16"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource SholtoTextBright}"
                         KeyDown="OnQueryKeyDown"/>

                <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1"
                        Background="{DynamicResource SholtoBorder}"/>

                <!-- Filtered results + tag bucket -->
                <ScrollViewer Grid.Row="2">
                    <StackPanel>
                        <!-- One navigable, grouped list: CRATES header + crate rows,
                             then TRACKS header + track rows. Headers are skipped by the
                             keyboard nav (SearchViewModel.Move); Enter/double-click
                             picks a crate (→ filter the library) or loads a track. -->
                        <ListBox x:Name="ResultsList"
                                 ItemsSource="{Binding Search.Items}"
                                 SelectedIndex="{Binding Search.SelectedIndex, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Focusable="False"
                                 Padding="0,4"
                                 DoubleTapped="OnResultActivated">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource SholtoAccentBg}"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.DataTemplates>
                                <!-- Section header -->
                                <DataTemplate DataType="vm:SearchHeader">
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="{DynamicResource SholtoTextMuted}"
                                               FontWeight="Bold" FontSize="11" LetterSpacing="1"
                                               Margin="20,8,20,2"/>
                                </DataTemplate>
                                <!-- Crate row -->
                                <DataTemplate DataType="data:CrateRef">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,5">
                                        <TextBlock Grid.Column="0" Text="📦" FontSize="15"
                                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SholtoTextBright}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TrackCount}"
                                                   Foreground="{DynamicResource SholtoTextMuted}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                                <!-- Track row -->
                                <DataTemplate DataType="vm:TrackRow">
                                    <Grid ColumnDefinitions="*,Auto,60" Margin="12,4">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding Artist}" FontWeight="Bold"
                                                       Foreground="{DynamicResource SholtoTextBright}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="—" Foreground="{DynamicResource SholtoTextMuted}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{DynamicResource SholtoTextBright}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding BpmDisplay}"
                                                   Foreground="{DynamicResource SholtoAccent}"
                                                   Margin="12,0" VerticalAlignment="Center"/>
                                        <!-- Camelot chip. Bound to Key (not Camelot — that property
                                             name doesn't exist on TrackRow; Key is the Camelot code
                                             rendered from the typed MusicalKey).
                                             Hidden when the track hasn't been analysed yet so the
                                             chip area collapses cleanly. -->
                                        <Border Grid.Column="2" Background="{Binding KeyBrush}"
                                                CornerRadius="3" Padding="6,2"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                IsVisible="{Binding Key, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="{Binding Key}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource SholtoKeyChipForeground}"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                                <!-- Tag row -->
                                <DataTemplate DataType="data:TagHit">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,5">
                                        <TextBlock Grid.Column="0" Text="🏷" FontSize="15"
                                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SholtoTextBright}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TrackCount}"
                                                   Foreground="{DynamicResource SholtoTextMuted}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.DataTemplates>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- Keyboard hint footer -->
                <TextBlock Grid.Row="3" Text="↑↓ move · ←→ deck · Enter load track / open crate / filter tag · Esc close"
                           FontSize="11" Foreground="{DynamicResource SholtoTextMuted}"
                           Margin="20,8,20,12"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
