<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sholto.Interface.MainUI.ViewModels"
             xmlns:glance="using:Sholto.Interface.MainUI.ViewModels.Glance"
             xmlns:data="using:Sholto.Data"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:controls="using:Sholto.Interface.MainUI.Controls"
             xmlns:chips="using:Sholto.Interface.MainUI.Controls.Chips"
             x:Class="Sholto.Interface.MainUI.Views.SearchOverlay"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding IsSearchOpen}"
             Focusable="False">

    <UserControl.Resources>
        <!-- Deck numbers as ints, for comparing a slot's Number. -->
        <x:Int32 x:Key="DeckOne">1</x:Int32>
        <x:Int32 x:Key="DeckTwo">2</x:Int32>
        <!-- The warning triangle (16x16 box) beside "Playing · −0:38". -->
        <StreamGeometry x:Key="DeckSlotLoadGlyph">M8,2V10 M4.5,6.5L8,10L11.5,6.5 M3,13H13</StreamGeometry>
        <!-- Track List glyphs (16x16 box): a list with a plus, a list with a tick. -->
        <StreamGeometry x:Key="LoadListPlusGlyph">M1.5,3.5H9.5 M1.5,8H9.5 M1.5,12.5H7 M12.5,9V15 M9.5,12H15.5</StreamGeometry>
        <StreamGeometry x:Key="LoadInListGlyph">M1.5,3.5H9.5 M1.5,8H9.5 M1.5,12.5H7 M9.5,12.5L11.5,14.5L15,10</StreamGeometry>
        <StreamGeometry x:Key="DeckSlotWarnGlyph">M8,1.5L15,14.5H1Z M7.25,6H8.75V10H7.25Z M7.25,11.25H8.75V12.75H7.25Z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Fit bar and tempo delta: the level picks a theme colour. None stays transparent. -->
        <Style Selector="Border.fitbar">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.fitbar.good"><Setter Property="Background" Value="{DynamicResource SholtoStatusOk}"/></Style>
        <Style Selector="Border.fitbar.usable"><Setter Property="Background" Value="{DynamicResource SholtoStatusWarn}"/></Style>
        <Style Selector="Border.fitbar.clash"><Setter Property="Background" Value="{DynamicResource SholtoTextMuted}"/></Style>
        <Style Selector="TextBlock.delta.good"><Setter Property="Foreground" Value="{DynamicResource SholtoStatusOk}"/></Style>
        <Style Selector="TextBlock.delta.usable"><Setter Property="Foreground" Value="{DynamicResource SholtoStatusWarn}"/></Style>
        <Style Selector="TextBlock.delta.clash"><Setter Property="Foreground" Value="{DynamicResource SholtoTextMuted}"/></Style>

        <!-- Rows: 42 px table rows, compact rail rows; the highlight follows the view model. -->
        <Style Selector="ListBox.table ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Transitions">
                <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.12"/></Transitions>
            </Setter>
        </Style>

        <!-- Results settle: a new ranking fades up 0.45 to 1 over 160 ms. Nothing moves or resizes while it does (no
             slide, no bar regrow): a result lands on every keystroke, and any geometry motion reads as the rows jumping.
             The view adds "fresh" for a moment after each result when motion is wanted. -->
        <Style Selector="ListBox.table.fresh">
            <Style.Animations>
                <Animation Duration="0:0:0.16" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.45"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Slow path: the old rows stay at 55 %, the real bars hide and FitShimmerColumn draws neutral ones with a light
             walking down them (one 1 s loop; with reduced motion the control draws the neutral bars alone). -->
        <Style Selector="ListBox.table.reassessing ListBoxItem">
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
        <Style Selector="ListBox.table.reassessing Border.fitbar">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="controls|FitShimmerColumn.running">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Phase" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Phase" Value="1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Rail crates and tags: dim at zero (still clickable), a count that ticks when it changes, a bold count when
             active. The active bar, tint and ring are drawn by the template. -->
        <Style Selector="Panel.railitem.zero"><Setter Property="Opacity" Value="0.38"/></Style>
        <Style Selector="TextBlock.count">
            <Setter Property="RenderTransform"><TranslateTransform/></Setter>
        </Style>
        <Style Selector="TextBlock.count.active">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SholtoTextBright}"/>
        </Style>
        <Style Selector="ListBoxItem.tick TextBlock.count">
            <Style.Animations>
                <Animation Duration="0:0:0.26" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.2"/><Setter Property="TranslateTransform.Y" Value="-4"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/><Setter Property="TranslateTransform.Y" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.tagpill">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style Selector="Border.tagpill.active">
            <Setter Property="BorderBrush" Value="{DynamicResource SholtoTagChipForeground}"/>
        </Style>

        <!-- Chips in the query box (the chip itself is the shared SourceChip); they slide in over 180 ms when motion is wanted (the overlay carries "motion"). -->
        <Style Selector="chips|SourceChip.chip">
            <Setter Property="RenderTransform"><TranslateTransform/></Setter>
        </Style>
        <Style Selector="UserControl.motion chips|SourceChip.chip">
            <Style.Animations>
                <Animation Duration="0:0:0.18" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/><Setter Property="TranslateTransform.X" Value="-6"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/><Setter Property="TranslateTransform.X" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="ListBox.rail ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox ListBoxItem:selected /template/ ContentPresenter, ListBox ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SholtoAccentBg}"/>
        </Style>
        <Style Selector="ListBox.dim ListBoxItem:selected /template/ ContentPresenter, ListBox.dim ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SholtoBorder}"/>
        </Style>

        <!-- The query box sits in its own bordered field; the template's focus and hover chrome would double it. -->
        <Style Selector="TextBox#QueryBox:focus /template/ Border#PART_BorderElement, TextBox#QueryBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="Border.keycap">
            <Setter Property="Background" Value="{DynamicResource SholtoBgDeep}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SholtoBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.keycap TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SholtoTextBright}"/>
        </Style>

        <!-- LOAD TO slots. State classes (bound in the slot template): on = target, empty, caution, armed.
             Fluent's hover restyles the template's ContentPresenter, so every state restates its look there. -->
        <Style Selector="Button.slot">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource SholtoSurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SholtoBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource SholtoTextBright}"/>
        </Style>
        <Style Selector="Button.slot /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.slot:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SholtoSurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SholtoAccent}"/>
        </Style>
        <Style Selector="Button.slot.on">
            <Setter Property="BorderBrush" Value="{DynamicResource SholtoAccent}"/>
            <Setter Property="Background" Value="{DynamicResource SholtoAccentBg}"/>
        </Style>
        <Style Selector="Button.slot.on:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SholtoAccentBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SholtoAccent}"/>
        </Style>
        <!-- Empty: the loaded card's gradient surface and solid border. The target keeps the accent border and
             adds a 2 px accent halo. Declared after .on so the gradient wins over the target's AccentBg. -->
        <Style Selector="Button.slot.empty">
            <Setter Property="Background" Value="{DynamicResource SholtoSlotEmptyFill}"/>
        </Style>
        <Style Selector="Button.slot.empty:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SholtoSlotEmptyFill}"/>
        </Style>
        <Style Selector="Button.slot.empty.on /template/ ContentPresenter, Button.slot.empty.on:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SholtoSlotEmptyFill}"/>
            <Setter Property="BoxShadow" Value="{DynamicResource SholtoSlotHalo}"/>
        </Style>
        <Style Selector="Button.slot.caution">
            <Setter Property="BorderBrush" Value="{DynamicResource SholtoStatusWarn}"/>
        </Style>
        <Style Selector="Button.slot.caution:pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource SholtoStatusWarn}"/>
        </Style>
        <Style Selector="Button.slot.armed">
            <Setter Property="BorderBrush" Value="{DynamicResource SholtoStatusError}"/>
            <Setter Property="Background" Value="{DynamicResource SholtoStatusErrorTint}"/>
        </Style>
        <Style Selector="Button.slot.armed:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SholtoStatusErrorTint}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SholtoStatusError}"/>
        </Style>

        <Style Selector="TextBlock.platternumber">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SholtoTextBright}"/>
        </Style>

        <!-- Empty slot: the deck number on the ghost record's label (BgDeep on the target's accent label), the two
             text lines, the key cap, and the target's light sweep (a band that crosses the card, 2.8 s a loop). -->
        <Style Selector="TextBlock.ghostnumber">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SholtoTextBright}"/>
        </Style>
        <Style Selector="TextBlock.ghostnumber.on">
            <Setter Property="Foreground" Value="{DynamicResource SholtoBgDeep}"/>
        </Style>
        <Style Selector="TextBlock.emptyword">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SholtoTextMuted}"/>
        </Style>
        <Style Selector="Rectangle.sweep">
            <Setter Property="Fill" Value="{DynamicResource SholtoSlotSweep}"/>
            <Setter Property="RenderTransform">
                <TranslateTransform X="-120"/>
            </Setter>
        </Style>
        <Style Selector="Rectangle.sweep.running">
            <Style.Animations>
                <Animation Duration="0:0:2.8" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="-120"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="480"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Load keys: small slanted parallelograms (skewX -8, text counter-skewed). Filled in the deck's colour on the
             target, an outline otherwise; the row's Track List key is always an outline. -->
        <Style Selector="Border.loadkey">
            <Setter Property="Height" Value="17"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="RenderTransform" Value="skewX(-8deg)"/>
        </Style>
        <Style Selector="Border.loadkey > TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="DejaVu Sans Mono, Consolas, monospace"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="RenderTransform" Value="skewX(8deg)"/>
        </Style>
        <Style Selector="Border.loadkey.d1"><Setter Property="BorderBrush" Value="{DynamicResource SholtoLoadDeck1}"/></Style>
        <Style Selector="Border.loadkey.d1 > TextBlock"><Setter Property="Foreground" Value="{DynamicResource SholtoLoadDeck1}"/></Style>
        <Style Selector="Border.loadkey.d2"><Setter Property="BorderBrush" Value="{DynamicResource SholtoLoadDeck2}"/></Style>
        <Style Selector="Border.loadkey.d2 > TextBlock"><Setter Property="Foreground" Value="{DynamicResource SholtoLoadDeck2}"/></Style>
        <Style Selector="Border.loadkey.list"><Setter Property="BorderBrush" Value="{DynamicResource SholtoLoadTrackList}"/></Style>
        <Style Selector="Border.loadkey.list > TextBlock"><Setter Property="Foreground" Value="{DynamicResource SholtoLoadTrackList}"/></Style>
        <Style Selector="Border.loadkey.d1.filled"><Setter Property="Background" Value="{DynamicResource SholtoLoadDeck1}"/></Style>
        <Style Selector="Border.loadkey.d2.filled"><Setter Property="Background" Value="{DynamicResource SholtoLoadDeck2}"/></Style>
        <Style Selector="Border.loadkey.filled > TextBlock"><Setter Property="Foreground" Value="{DynamicResource SholtoBgDeep}"/></Style>

        <!-- The deck's own 6 px stripe down the slot's left edge. The target's slot is washed in the deck's colour. -->
        <Style Selector="Border.stripe.d1"><Setter Property="Background" Value="{DynamicResource SholtoLoadDeck1}"/></Style>
        <Style Selector="Border.stripe.d2"><Setter Property="Background" Value="{DynamicResource SholtoLoadDeck2}"/></Style>
        <Style Selector="Button.slot.on.d1"><Setter Property="BorderBrush" Value="{DynamicResource SholtoLoadDeck1}"/></Style>
        <Style Selector="Button.slot.on.d1:pointerover /template/ ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource SholtoLoadDeck1}"/></Style>
        <Style Selector="Button.slot.on.d2"><Setter Property="BorderBrush" Value="{DynamicResource SholtoLoadDeck2}"/></Style>
        <Style Selector="Button.slot.on.d2:pointerover /template/ ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource SholtoLoadDeck2}"/></Style>
        <Style Selector="Button.slot.on.d1:not(.empty)"><Setter Property="Background" Value="{DynamicResource SholtoSlotDeck1Wash}"/></Style>
        <Style Selector="Button.slot.on.d1:not(.empty):pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource SholtoSlotDeck1Wash}"/></Style>
        <Style Selector="Button.slot.on.d2:not(.empty)"><Setter Property="Background" Value="{DynamicResource SholtoSlotDeck2Wash}"/></Style>
        <Style Selector="Button.slot.on.d2:not(.empty):pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource SholtoSlotDeck2Wash}"/></Style>

        <!-- The highlighted row shows its Track List key; a row just added flashes violet for 600 ms (the view sets "flash"). -->
        <Style Selector="Border.rowkey"><Setter Property="IsVisible" Value="False"/></Style>
        <Style Selector="ListBoxItem:selected Border.rowkey"><Setter Property="IsVisible" Value="True"/></Style>
        <Style Selector="Border.flashfill"><Setter Property="Opacity" Value="0"/></Style>
        <Style Selector="ListBoxItem.flash Border.flashfill">
            <Style.Animations>
                <Animation Duration="0:0:0.6" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.18"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Path.notch">
            <Setter Property="Fill" Value="{DynamicResource SholtoAccent}"/>
        </Style>
        <Style Selector="Path.notch.caution">
            <Setter Property="Fill" Value="{DynamicResource SholtoStatusWarn}"/>
        </Style>
        <Style Selector="Path.notch.armed">
            <Setter Property="Fill" Value="{DynamicResource SholtoStatusError}"/>
        </Style>

        <Style Selector="TextBlock.slotline">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="LineHeight" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SholtoTextMuted}"/>
        </Style>
        <Style Selector="TextBlock.slotline.mono">
            <Setter Property="FontFamily" Value="DejaVu Sans Mono, Consolas, monospace"/>
        </Style>
        <Style Selector="TextBlock.slotline.warn">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SholtoStatusWarn}"/>
        </Style>
        <Style Selector="TextBlock.slotline.loads">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SholtoAccent}"/>
        </Style>
        <Style Selector="TextBlock.slotline.err">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SholtoStatusError}"/>
        </Style>
        <Style Selector="TextBlock.slottitle">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{DynamicResource SholtoTextBright}"/>
        </Style>
        <Style Selector="TextBlock.slotbpm">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontFamily" Value="DejaVu Sans Mono, Consolas, monospace"/>
            <Setter Property="LetterSpacing" Value="-0.3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SholtoTextBright}"/>
        </Style>
        <Style Selector="TextBlock.cautiontext">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="0.8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SholtoStatusWarn}"/>
        </Style>
        <Style Selector="TextBlock.emptydeck">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontFamily" Value="DejaVu Sans Mono, Consolas, monospace"/>
            <Setter Property="LetterSpacing" Value="0.3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SholtoTextBright}"/>
        </Style>
        <Style Selector="TextBlock.slottitle.muted">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource SholtoTextMuted}"/>
        </Style>
    </UserControl.Styles>

    <!-- Backdrop dims everything behind the panel; a click outside the panel closes (handler in code-behind). -->
    <Grid Background="{DynamicResource SholtoScrim}" PointerPressed="OnBackdropPressed">

        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                MaxWidth="1000" MaxHeight="680" Margin="24"
                Background="{DynamicResource SholtoSurfaceRaised}"
                BorderBrush="{DynamicResource SholtoBorder}" BorderThickness="1"
                CornerRadius="8" ClipToBounds="True"
                PointerPressed="OnPanelPressed">

            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

                <!-- Header strip: the two decks, wide. A click on a deck loads the highlighted song there. -->
                <Border Grid.Row="0" Background="{DynamicResource SholtoSurface}"
                        BorderBrush="{DynamicResource SholtoBorder}" BorderThickness="0,0,0,1"
                        Padding="11,10" DataContext="{Binding Glance.Header}" x:DataType="glance:IGlanceHeaderViewModel">
                    <ItemsControl ItemsSource="{Binding Slots}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="glance:IDeckSlotViewModel">
                                <Grid Height="64" Margin="3,0">
                                    <Button Classes="slot" Click="OnSlotClick"
                                            Classes.on="{Binding IsTarget}" Classes.empty="{Binding !IsLoaded}"
                                            Classes.caution="{Binding IsCaution}" Classes.armed="{Binding IsArmed}"
                                            Classes.d1="{Binding Number, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={StaticResource DeckOne}}"
                                            Classes.d2="{Binding Number, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={StaticResource DeckTwo}}">
                                        <Panel>
                                            <Panel IsVisible="{Binding IsLoaded}">
                                                <Border Classes="stripe" Width="6" HorizontalAlignment="Left" CornerRadius="5,0,0,5" IsHitTestVisible="False"
                                                        Classes.d1="{Binding Number, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={StaticResource DeckOne}}"
                                                        Classes.d2="{Binding Number, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={StaticResource DeckTwo}}"/>
                                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0,12,0">
                                                    <Panel Width="52" Height="52">
                                                        <controls:DeckSlotPlatter Width="52" Height="52" Slot="{Binding}"
                                                                                  TrackBrush="{DynamicResource SholtoBorder}"
                                                                                  PlayingBrush="{DynamicResource SholtoStatusOk}"
                                                                                  MutedBrush="{DynamicResource SholtoTextMuted}"
                                                                                  LowBrush="{DynamicResource SholtoStatusError}"
                                                                                  AccentBrush="{DynamicResource SholtoAccent}"
                                                                                  DiscBrush="{DynamicResource SholtoBgDeep}"
                                                                                  LabelBrush="{DynamicResource SholtoSurface}"
                                                                                  MarkerBrush="{DynamicResource SholtoTextBright}"/>
                                                        <!-- The deck number on the label; text laid over the platter, not drawn by it. -->
                                                        <TextBlock Classes="platternumber" IsHitTestVisible="False"><Run FontSize="9" Text="⇧"/><Run Text="{Binding Number}"/></TextBlock>
                                                    </Panel>
                                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" Spacing="3" VerticalAlignment="Center">
                                                        <TextBlock Classes="slottitle" Text="{Binding Title}"/>
                                                        <Panel Height="22">
                                                            <StackPanel Classes="stats" Orientation="Horizontal" Spacing="6"
                                                                        IsVisible="{Binding ShowStats}">
                                                                <Border MinWidth="36" Height="22" CornerRadius="4" Padding="6,0" VerticalAlignment="Center"
                                                                        Background="{Binding KeyBrush}"
                                                                        IsVisible="{Binding Camelot, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                    <TextBlock Text="{Binding Camelot}" FontSize="12.5" FontWeight="ExtraBold"
                                                                               Foreground="{DynamicResource SholtoKeyChipForeground}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Classes="slotbpm" Text="{Binding BpmText}"/>
                                                            </StackPanel>
                                                            <Border Background="{DynamicResource SholtoStatusWarnTint}" CornerRadius="4" Height="22" Padding="8,0"
                                                                    HorizontalAlignment="Left" IsVisible="{Binding ShowCaution}">
                                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                    <Path Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                                                                          Fill="{DynamicResource SholtoStatusWarn}" Data="{StaticResource DeckSlotWarnGlyph}"/>
                                                                    <TextBlock Classes="cautiontext" Text="PLAYING"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <TextBlock Classes="slotline err" Text="{Binding ArmedText}" TextTrimming="CharacterEllipsis"
                                                                       IsVisible="{Binding ShowArmed}"/>
                                                        </Panel>
                                                    </StackPanel>
                                                </Grid>
                                            </Panel>
                                                    <!-- Empty: a ghost record cropped by the card's left edge (the clip), the deck number on its
                                                         label, the deck's name, its key, and on the target a light sweep. -->
                                                    <Border CornerRadius="5" ClipToBounds="True" IsVisible="{Binding !IsLoaded}"
                                                            AutomationProperties.Name="{Binding EmptyTitle}">
                                                        <Panel>
                                                            <Rectangle Classes="sweep" Classes.running="{Binding IsSweeping}"
                                                                       Width="120" HorizontalAlignment="Left" IsHitTestVisible="False"
                                                                       IsVisible="{Binding IsSweeping}"/>
                                                            <controls:DeckSlotPlatter Ghost="True" Width="64" Height="64" Slot="{Binding}"
                                                                                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-18,0,0,0"
                                                                                      TrackBrush="{DynamicResource SholtoBorder}"
                                                                                      PlayingBrush="{DynamicResource SholtoStatusOk}"
                                                                                      MutedBrush="{DynamicResource SholtoTextMuted}"
                                                                                      AccentBrush="{DynamicResource SholtoAccent}"
                                                                                      DiscBrush="{DynamicResource SholtoBgDeep}"
                                                                                      RaisedBrush="{DynamicResource SholtoSurfaceRaised}"
                                                                                      LabelBrush="{DynamicResource SholtoSurface}"
                                                                                      MarkerBrush="{DynamicResource SholtoTextBright}"/>
                                                            <TextBlock Classes="ghostnumber" Classes.on="{Binding IsTarget}"
                                                                       Width="24" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                       Margin="2,0,0,0" IsHitTestVisible="False"><Run FontSize="9" Text="⇧"/><Run Text="{Binding Number}"/></TextBlock>
                                                            <Grid ColumnDefinitions="*,Auto" Margin="56,0,12,0" IsHitTestVisible="False">
                                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                    <TextBlock Classes="emptydeck" Text="{Binding Number, StringFormat='DECK {0}'}"/>
                                                                    <TextBlock Classes="emptyword" Text="empty"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Panel>
                                                    </Border>
                                        </Panel>
                                    </Button>
                                    
<!-- The notch on the top border points into the target. -->
                                    <Path Classes="notch" Classes.caution="{Binding IsCaution}" Classes.armed="{Binding IsArmed}"
                                          Data="M0,0 L16,0 L8,8 Z" Width="16" Height="8" Margin="0,-1,0,0"
                                          HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"
                                          IsVisible="{Binding IsTarget}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Query row: the box plus what the query was understood as. -->
                <Border Grid.Row="1" Padding="12,8" BorderBrush="{DynamicResource SholtoBorder}" BorderThickness="0,0,0,1">
                    <Border Background="{DynamicResource SholtoBgDeep}" BorderBrush="{DynamicResource SholtoBorder}"
                            BorderThickness="1" CornerRadius="6" Padding="10,0">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"
                                       IsHitTestVisible="False"/>
                            <!-- The crates and tags narrowing the list, in pick order, before the caret. -->
                            <ItemsControl x:Name="ChipList" Grid.Column="1" ItemsSource="{Binding Glance.Chips}" Margin="0,0,6,0"
                                          VerticalAlignment="Center" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="glance:GlanceChip">
                                        <chips:SourceChip Classes="chip" Kind="{Binding ChipKind}" Text="{Binding Name}"
                                                          Removed="OnChipRemoved"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox x:Name="QueryBox" Grid.Column="2"
                                     Text="{Binding Glance.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Watermark="Name, initials (bsn), bpm:128, key:8A, #tag"
                                     FontSize="17" Padding="0,8" MinHeight="40"
                                     FontFamily="DejaVu Sans Mono, Consolas, monospace"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource SholtoTextBright}"/>
                            <TextBlock x:Name="CompletionGhost" Grid.Column="2" IsHitTestVisible="False" IsVisible="False"
                                       FontSize="17" Padding="0,8" VerticalAlignment="Center"
                                       FontFamily="DejaVu Sans Mono, Consolas, monospace">
                                <Run x:Name="GhostTyped" Foreground="Transparent"/><Run x:Name="GhostSuffix" Foreground="{DynamicResource SholtoTextMuted}"/>
                            </TextBlock>
                            <ItemsControl Grid.Column="3" ItemsSource="{Binding Glance.FilterChips}" Margin="8,0"
                                          VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border BorderBrush="{DynamicResource SholtoBorder}" BorderThickness="1"
                                                CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold"
                                                       FontFamily="DejaVu Sans Mono, Consolas, monospace"
                                                       Foreground="{DynamicResource SholtoTextBright}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Border>

                <!-- Body: the rail on the left, the table on the right. -->
                <Grid Grid.Row="2" ColumnDefinitions="220,*">
                    <Border Grid.Column="0" Background="{DynamicResource SholtoSurface}"
                            BorderBrush="{DynamicResource SholtoBorder}" BorderThickness="0,0,1,0">
                        <ListBox x:Name="RailList" Classes="rail" Background="Transparent" BorderThickness="0"
                                 Focusable="False" Padding="0,6" SelectionChanged="OnRailSelectionChanged">
                            <ListBox.DataTemplates>
                                <DataTemplate DataType="glance:GlanceRailHeader" x:DataType="glance:GlanceRailHeader">
                                    <Grid ColumnDefinitions="*,Auto" Margin="12,8,12,3" IsHitTestVisible="False">
                                        <TextBlock Text="{Binding Title}" FontSize="10" FontWeight="Bold" LetterSpacing="1.3"
                                                   Foreground="{DynamicResource SholtoTextMuted}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource SholtoTextMuted}"/>
                                    </Grid>
                                </DataTemplate>
                                <!-- Crate: the cube and name in mint, the count at the right. Active: a 3 px mint bar, a faint mint tint, a bold count. -->
                                <DataTemplate DataType="glance:GlanceRailCrate" x:DataType="glance:GlanceRailCrate">
                                    <Panel Classes="railitem" Classes.zero="{Binding IsZero}" Height="30">
                                        <Border Background="{DynamicResource SholtoMint}" Opacity="0.11" IsHitTestVisible="False"
                                                IsVisible="{Binding IsActive}"/>
                                        <Border Width="3" Margin="0,4" HorizontalAlignment="Left" CornerRadius="0,2,2,0"
                                                Background="{DynamicResource SholtoMint}" IsHitTestVisible="False"
                                                IsVisible="{Binding IsActive}"/>
                                        <Grid ColumnDefinitions="Auto,*,28" Margin="12,0">
                                            <Path Width="12" Height="12" VerticalAlignment="Center" Stretch="Uniform"
                                                  Data="M6,1 L11,3.5 L11,8.5 L6,11 L1,8.5 L1,3.5 Z M1,3.5 L6,6 L11,3.5 M6,6 L6,11"
                                                  Stroke="{DynamicResource SholtoMint}" StrokeThickness="1.2" StrokeJoin="Round"/>
                                            <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Name}" FontSize="13.5" LineHeight="18"
                                                       Foreground="{DynamicResource SholtoMint}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Classes="count" Classes.active="{Binding IsActive}"
                                                       Text="{Binding Count}" FontSize="11" LineHeight="14"
                                                       Foreground="{DynamicResource SholtoTextMuted}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Panel>
                                </DataTemplate>
                                <!-- Tag: the pill, the count at the right. Active: a 3 px bar and faint wash in the pill's colour, a ring on the pill, a bold count. -->
                                <DataTemplate DataType="glance:GlanceRailTag" x:DataType="glance:GlanceRailTag">
                                    <Panel Classes="railitem" Classes.zero="{Binding IsZero}" Height="30">
                                        <Border Background="{DynamicResource SholtoTagChipBackground}" Opacity="0.22" IsHitTestVisible="False"
                                                IsVisible="{Binding IsActive}"/>
                                        <Border Width="3" Margin="0,4" HorizontalAlignment="Left" CornerRadius="0,2,2,0"
                                                Background="{DynamicResource SholtoTagChipBackground}" IsHitTestVisible="False"
                                                IsVisible="{Binding IsActive}"/>
                                        <Grid ColumnDefinitions="*,28" Margin="12,0">
                                            <Border Classes="tagpill" Classes.active="{Binding IsActive}" Height="20" CornerRadius="10" Padding="6.5,0"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="{DynamicResource SholtoTagChipBackground}">
                                                <TextBlock Text="{Binding Name}" FontSize="11" LineHeight="14"
                                                           Foreground="{DynamicResource SholtoTagChipForeground}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Classes="count" Classes.active="{Binding IsActive}"
                                                       Text="{Binding Count}" FontSize="11" LineHeight="14"
                                                       Foreground="{DynamicResource SholtoTextMuted}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Panel>
                                </DataTemplate>
                            </ListBox.DataTemplates>
                        </ListBox>
                    </Border>

                    <Grid Grid.Column="1" RowDefinitions="Auto,*">
                        <!-- Column labels; widths match the row template below. -->
                        <Grid Grid.Row="0" ColumnDefinitions="22,72,*,96,64,40" Margin="10,0,16,0" Height="28">
                            <TextBlock Grid.Column="0" Text="" Classes="colhead"/>
                            <TextBlock Grid.Column="1" Text="KEY" Classes="colhead"/>
                            <TextBlock Grid.Column="2" Text="TITLE / ARTIST" Classes="colhead"/>
                            <TextBlock Grid.Column="3" Text="BPM" Classes="colhead" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="TIME" Classes="colhead" HorizontalAlignment="Right"/>
                            <Grid.Styles>
                                <Style Selector="TextBlock.colhead">
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="LetterSpacing" Value="1.1"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SholtoTextMuted}"/>
                                </Style>
                            </Grid.Styles>
                        </Grid>

                        <!-- The table is a virtualised ListBox filling its row: it is its own scroller, so only the
                             visible rows exist however many tracks the library has. -->
                        <ListBox x:Name="ResultsList" Grid.Row="1" Classes="table"
                                 Background="Transparent" BorderThickness="0" Focusable="False" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnResultsSelectionChanged"
                                 DoubleTapped="OnResultActivated">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="glance:GlanceRow">
                                    <Grid ColumnDefinitions="22,72,*,96,64,40" Margin="10,0,6,0" Height="42"
                                          Classes.faded="{Binding IsFaded}">
                                        <Border Grid.ColumnSpan="6" Classes="flashfill" Margin="-10,0,-6,0" IsHitTestVisible="False"
                                                Background="{DynamicResource SholtoLoadTrackList}"/>
                                        <Border Grid.Column="0" Classes="fitbar" Width="6" Height="30" CornerRadius="3"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Classes.good="{Binding FitLevel, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static data:FitLevel.Good}}"
                                                Classes.usable="{Binding FitLevel, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static data:FitLevel.Usable}}"
                                                Classes.clash="{Binding FitLevel, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static data:FitLevel.Clash}}"/>
                                        <Border Grid.Column="1" MinWidth="42" Height="24" CornerRadius="4" Padding="6,0"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{Binding Row.KeyBrush}"
                                                IsVisible="{Binding Row.Key, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="{Binding Row.Key}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{DynamicResource SholtoKeyChipForeground}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Grid Grid.Column="2" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Row.Title}" FontSize="15" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource SholtoTextBright}"
                                                       Classes.faded="{Binding IsFaded}">
                                                <TextBlock.Styles>
                                                    <Style Selector="TextBlock.faded">
                                                        <Setter Property="Foreground" Value="{DynamicResource SholtoTextMuted}"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                    </Style>
                                                </TextBlock.Styles>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource SholtoTextMuted}"/>
                                        </StackPanel>
                                        <!-- The highlighted row's Track List key: add (Ctrl L), or the tick once it is in. -->
                                        <Border Grid.Column="1" Classes="loadkey list rowkey" Margin="8,0" IsHitTestVisible="False">
                                            <Panel>
                                                <TextBlock Text="≡+ Ctrl L" IsVisible="{Binding !IsInTrackList}"/>
                                                <TextBlock Text="≡✓" IsVisible="{Binding IsInTrackList}"/>
                                            </Panel>
                                        </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Row.BpmDisplay}" FontSize="16" FontWeight="SemiBold"
                                                       FontFamily="DejaVu Sans Mono, Consolas, monospace"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource SholtoAccent}"/>
                                            <TextBlock Text="{Binding TempoDeltaDisplay}" Classes="delta" FontSize="11"
                                                       FontFamily="DejaVu Sans Mono, Consolas, monospace"
                                                       HorizontalAlignment="Right"
                                                       Classes.good="{Binding TempoDeltaLevel, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static data:FitLevel.Good}}"
                                                       Classes.usable="{Binding TempoDeltaLevel, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static data:FitLevel.Usable}}"
                                                       Classes.clash="{Binding TempoDeltaLevel, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static data:FitLevel.Clash}}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="4" Text="{Binding Row.DurationDisplay}" FontSize="13"
                                                   FontFamily="DejaVu Sans Mono, Consolas, monospace"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SholtoTextMuted}"/>
                                        <Panel Grid.Column="5" Background="Transparent" Tapped="OnStarTapped">
                                            <Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource LoadListPlusGlyph}"
                                                  Stroke="{DynamicResource SholtoBorder}" StrokeThickness="1.7" StrokeLineCap="Round"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsVisible="{Binding !IsInTrackList}"/>
                                            <Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource LoadInListGlyph}"
                                                  Stroke="{DynamicResource SholtoLoadTrackList}" StrokeThickness="1.7" StrokeLineCap="Round"
                                                  StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsVisible="{Binding IsInTrackList}"/>
                                        </Panel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- The slow indicator over the FIT column (the bars sit 10 px in, one 22 px column wide). -->
                        <controls:FitShimmerColumn x:Name="FitShimmer" Grid.Row="1" Width="6" HorizontalAlignment="Left"
                                                   Margin="10,0,0,0" IsVisible="False"
                                                   Light="{DynamicResource SholtoPrimary}"
                                                   Neutral="{DynamicResource SholtoTextMuted}"/>

                        <TextBlock x:Name="EmptyHint" Grid.Row="1" Margin="20,28" TextWrapping="Wrap" IsHitTestVisible="False"
                                   Foreground="{DynamicResource SholtoTextMuted}"
                                   Text="{Binding Glance.Query, StringFormat='Nothing matches “{0}”. Initials work too: try bsn.'}"/>
                        <!-- Chips leave nothing: one centred line, the names in bright text (filled by the view). -->
                        <TextBlock x:Name="ScopeEmptyHint" Grid.Row="1" Margin="20,96,20,0" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False" IsVisible="False"
                                   FontSize="14" Foreground="{DynamicResource SholtoTextMuted}"/>
                    </Grid>
                </Grid>

                <!-- The warning a load onto a playing deck raises, until its second press or the 3 s are up. -->
                <Border Grid.Row="3" Padding="14,8" Background="{DynamicResource SholtoStatusWarnTint}"
                        BorderBrush="{DynamicResource SholtoStatusWarn}" BorderThickness="0,1,0,0"
                        IsVisible="{Binding LoadFeedback.HasWarning}">
                    <TextBlock Text="{Binding LoadFeedback.WarningText}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource SholtoStatusWarn}"/>
                </Border>

                <!-- Status line: counts, key hints, what Enter does. -->
                <Border Grid.Row="4" Padding="12,6" Background="{DynamicResource SholtoSurface}"
                        BorderBrush="{DynamicResource SholtoBorder}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Glance.Rows.Count}" FontSize="11.5" FontWeight="Bold"
                                       Foreground="{DynamicResource SholtoTextBright}"/>
                            <TextBlock Text="{Binding Glance.ScopeCount, StringFormat='of {0}'}" FontSize="11.5"
                                       Foreground="{DynamicResource SholtoTextMuted}"/>
                            <Path Width="12" Height="12" Margin="6,0,0,0" Stretch="Uniform" Data="{StaticResource LoadInListGlyph}"
                                  Stroke="{DynamicResource SholtoLoadTrackList}" StrokeThickness="1.7" StrokeLineCap="Round"
                                  StrokeJoin="Round" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TrackListCountText" Text="{Binding Glance.TrackListCount}" FontSize="11.5" FontWeight="Bold"
                                       Foreground="{DynamicResource SholtoLoadTrackList}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border Classes="keycap"><TextBlock Text="Tab"/></Border>
                                <TextBlock x:Name="TabHintText" Text="Rail / Table" FontSize="11.5" Foreground="{DynamicResource SholtoTextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border Classes="keycap"><TextBlock Text="←→"/></Border>
                                <TextBlock Text="Deck" FontSize="11.5" Foreground="{DynamicResource SholtoTextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel x:Name="RemoveChipHint" Orientation="Horizontal" Spacing="5" IsVisible="False">
                                <Border Classes="keycap"><TextBlock Text="⌫"/></Border>
                                <TextBlock Text="Remove filter" FontSize="11.5" Foreground="{DynamicResource SholtoTextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border Classes="keycap"><TextBlock Text="Ctrl Del"/></Border>
                                <TextBlock x:Name="ClearHintText" Text="Clear Track List" FontSize="11.5"
                                           Foreground="{DynamicResource SholtoTextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border Classes="keycap"><TextBlock Text="Enter"/></Border>
                                <TextBlock Text="{Binding Glance.ActionText}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SholtoTextBright}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
