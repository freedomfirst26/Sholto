<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sholto.Interface.MainUI.Views.LayoutWizardStepper"
             Focusable="False">

    <UserControl.Styles>
        <Style Selector="Border.tag">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.tag TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="0.8"/>
        </Style>
        <Style Selector="Border.tag.current">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SholtoBorder}"/>
            <Setter Property="Background" Value="{DynamicResource SholtoBgDeep}"/>
        </Style>
        <Style Selector="Border.tag.current TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SholtoTextMuted}"/>
        </Style>

        <!-- Stepper -->
        <Style Selector="Button.sn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SholtoTextMuted}"/>
        </Style>
        <Style Selector="Button.sn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.sn.on">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SholtoTextBright}"/>
        </Style>
        <Style Selector="Button.sn.done:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource SholtoTextBright}"/>
        </Style>
        <Style Selector="Border.bub">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SholtoBorder}"/>
        </Style>
        <Style Selector="Button.on Border.bub">
            <Setter Property="Background" Value="{DynamicResource SholtoAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SholtoAccent}"/>
        </Style>
        <Style Selector="Button.done Border.bub">
            <Setter Property="BorderBrush" Value="{DynamicResource SholtoAccent}"/>
        </Style>
        <Style Selector="Border.bub TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SholtoTextMuted}"/>
        </Style>
        <Style Selector="Button.on Border.bub TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SholtoBgDeep}"/>
        </Style>
        <Style Selector="Button.done Border.bub TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SholtoAccent}"/>
        </Style>
        <Style Selector="Border.ln">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="2"/>
            <Setter Property="CornerRadius" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SholtoBorder}"/>
        </Style>
        <Style Selector="Border.ln.done">
            <Setter Property="Background" Value="{DynamicResource SholtoAccent}"/>
        </Style>
    </UserControl.Styles>

    <!-- Stepper: the done step shows what was picked and goes back when clicked. -->
    <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="sn" Classes.on="{Binding IsThemeStep}" Classes.done="{Binding IsWaveformStep}"
                Click="OnBack">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <Border Classes="bub"><TextBlock Text="1"/></Border>
                <TextBlock Text="Theme" VerticalAlignment="Center"/>
                <Border Classes="tag current" IsVisible="{Binding IsWaveformStep}">
                    <TextBlock Text="{Binding ThemeSummary}"/>
                </Border>
            </StackPanel>
        </Button>
        <Border Classes="ln" Classes.done="{Binding IsWaveformStep}" VerticalAlignment="Center"/>
        <Button Classes="sn" Classes.on="{Binding IsWaveformStep}" IsHitTestVisible="False" Focusable="False">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <Border Classes="bub"><TextBlock Text="2"/></Border>
                <TextBlock Text="Waveform" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
