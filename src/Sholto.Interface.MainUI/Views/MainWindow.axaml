<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Sholto.Interface.MainUI.Controls"
        xmlns:v="using:Sholto.Interface.MainUI.Views"
        xmlns:fp="using:Sholto.Interface.Faceplate.Views"
        xmlns:cti="using:Sholto.Interface.MainUI.Controls.CollapseToIcon"
        xmlns:modal="using:Sholto.Interface.MainUI.Controls.Modal"
        xmlns:media="using:Avalonia.Media"
        x:Class="Sholto.Interface.MainUI.Views.MainWindow"
        Title="Sholto"
        Width="1200" Height="900"
        Background="{DynamicResource SholtoBgDeep}">

    <Grid>
    <DockPanel>
        <!-- Top bar: Menu on the left, optional CPU/RAM readout on the right (visible
             only when SHOLTO_DEBUG_STATS=1 has been set on launch). Both share the
             SurfaceRaised background so the bar reads as a single strip. -->
        <DockPanel DockPanel.Dock="Top"
                   Background="{DynamicResource SholtoSurfaceRaised}">
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding DebugStats}"
                       IsVisible="{Binding DebugStatsVisible}"
                       FontFamily="monospace" FontSize="11"
                       Foreground="{DynamicResource SholtoTextMuted}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
        <!-- Controller connection indicator: green "Controller" when the DDJ-FLX4
             is connected, red "Reconnect USB" when it drops off the bus. The
             reconnect supervisor keeps retrying; if it stays red, the device is
             fully gone and needs an unplug/replug. -->
        <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                CornerRadius="10" Padding="8,3"
                Classes.degraded="{Binding SystemDegraded}"
                Classes.disconnected="{Binding !ControllerConnected}"
                PointerPressed="OnStatusDotPressed">
            <Border.Styles>
                <Style Selector="Border">
                    <Setter Property="Background" Value="{DynamicResource SholtoStatusOkTint}"/>
                </Style>
                <!-- Amber: an analysis tool is missing. MainViewModel.SystemDegraded is
                     false whenever the controller is down, so red always wins and the
                     dot only ever shows one colour — the .degraded rules below can
                     never be live at the same time as the .disconnected ones. -->
                <Style Selector="Border.degraded">
                    <Setter Property="Background" Value="{DynamicResource SholtoStatusWarnTint}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="ToolTip.Tip" Value="Some analysis tools are missing — click for the system report"/>
                </Style>
                <Style Selector="Border.disconnected">
                    <Setter Property="Background" Value="{DynamicResource SholtoStatusErrorTint}"/>
                </Style>
                <Style Selector="Ellipse.dot">
                    <Setter Property="Fill" Value="{DynamicResource SholtoStatusOk}"/>
                </Style>
                <Style Selector="Border.degraded Ellipse.dot">
                    <Setter Property="Fill" Value="{DynamicResource SholtoStatusWarn}"/>
                </Style>
                <Style Selector="Border.disconnected Ellipse.dot">
                    <Setter Property="Fill" Value="{DynamicResource SholtoStatusError}"/>
                </Style>
                <Style Selector="TextBlock.label">
                    <Setter Property="Foreground" Value="{DynamicResource SholtoStatusOk}"/>
                </Style>
                <Style Selector="Border.degraded TextBlock.label">
                    <Setter Property="Foreground" Value="{DynamicResource SholtoStatusWarn}"/>
                </Style>
                <Style Selector="Border.disconnected TextBlock.label">
                    <Setter Property="Foreground" Value="{DynamicResource SholtoStatusError}"/>
                </Style>
            </Border.Styles>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse Classes="dot" Width="8" Height="8" VerticalAlignment="Center"/>
                <!-- Connected = just the green dot; the label only appears to prompt
                     a reconnect when the controller has dropped. -->
                <TextBlock Classes="label" Text="{Binding ControllerStatusText}"
                           IsVisible="{Binding !ControllerConnected}"
                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <!-- Controller guide entry point. The ONLY way to open the Faceplate overlay —
             deliberately no keyboard shortcut. A mini controller, white outline (a
             stroke, no fill) so it reads as chrome rather than competing with the
             amber the guide itself uses. -->
        <Button x:Name="FaceplateButton" ClipToBounds="False" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand" ToolTip.Tip="Controller guide"
                Click="OnFaceplateButtonClick">
            <Button.Styles>
                <!-- The icon's strokes come from here, not from the shapes themselves, so ":hinting" can retint them.
                     Selected by the "pulse" class, not by type: IconHintPulse borrows ContentControl's style key. -->
                <Style Selector="Button#FaceplateButton :is(Shape).glyph">
                    <Setter Property="Stroke" Value="{DynamicResource SholtoTextBright}"/>
                </Style>
                <Style Selector="Button#FaceplateButton .pulse:hinting :is(Shape).glyph">
                    <Setter Property="Stroke" Value="{DynamicResource SholtoAccent}"/>
                </Style>
            </Button.Styles>
            <!-- Padding with the matching negative Margin: the pulse rings draw wider than the icon, and a
                 control only paints inside its own bounds. Layout size stays the icon's. -->
            <cti:IconHintPulse x:Name="FaceplateIcon" Classes="pulse" Sequence="{Binding FaceplateDock}"
                               RingBrush="{DynamicResource SholtoAccent}" Padding="20" Margin="-20">
            <Viewbox Width="22" Height="16" Stretch="Uniform">
                <Canvas Width="30" Height="22">
                    <!-- Body -->
                    <Rectangle Classes="glyph" Canvas.Left="1" Canvas.Top="3" Width="28" Height="16"
                               RadiusX="2" RadiusY="2" StrokeThickness="1.4" Fill="Transparent"/>
                    <!-- Two jog-wheel circles -->
                    <Ellipse Classes="glyph" Canvas.Left="4" Canvas.Top="6" Width="10" Height="10" StrokeThickness="1.2" Fill="Transparent"/>
                    <Ellipse Classes="glyph" Canvas.Left="16" Canvas.Top="6" Width="10" Height="10" StrokeThickness="1.2" Fill="Transparent"/>
                    <!-- Crossfader nub -->
                    <Rectangle Classes="glyph" Canvas.Left="12" Canvas.Top="16" Width="6" Height="2" StrokeThickness="0.8" Fill="Transparent"/>
                </Canvas>
            </Viewbox>
            </cti:IconHintPulse>
        </Button>
        <Menu Background="Transparent"
              Foreground="{DynamicResource SholtoTextBright}">
            <MenuItem Header="Settings">
                <MenuItem Header="Theme" x:Name="ThemesMenu"/>
                <MenuItem Header="Music folder…" Click="OnMusicFolderClick"/>
                <MenuItem Header="Output device…" Click="OnOutputDeviceClick"/>
                <MenuItem Header="Layout Wizard…" Click="OnLayoutWizardClick"/>
                <MenuItem Header="Settings…" Click="OnSettingsClick"/>
            </MenuItem>
        </Menu>
        </DockPanel>

    <!-- Decks get a 64px section-map strip (14 label row + 50 whole-track waveform) + 218px of
         scrolling waveform/disc/chips = 282 each, so the map never eats into the deck content. -->
    <Grid RowDefinitions="*,8,282,282">

        <!-- Track library, rendered as a fixed-column table. -->
        <Grid Grid.Row="0" RowDefinitions="32,*" Background="{DynamicResource SholtoSurface}">

            <!-- Column header -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="80,50,240,*,80,80,80"
                  Background="{DynamicResource SholtoSurfaceRaised}">
                <TextBlock Grid.Column="0" Text="ANALYZED"
                           Foreground="{DynamicResource SholtoTextMuted}" FontWeight="Bold" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="TAGS"
                           Foreground="{DynamicResource SholtoTextMuted}" FontWeight="Bold" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="ARTIST"
                           Foreground="{DynamicResource SholtoTextMuted}" FontWeight="Bold" FontSize="11"
                           Margin="12,8" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="TRACK"
                           Foreground="{DynamicResource SholtoTextMuted}" FontWeight="Bold" FontSize="11"
                           Margin="8,8" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="BPM"
                           Foreground="{DynamicResource SholtoTextMuted}" FontWeight="Bold" FontSize="11"
                           Margin="8,8" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="KEY"
                           Foreground="{DynamicResource SholtoTextMuted}" FontWeight="Bold" FontSize="11"
                           Margin="8,8" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="6" Text="TIME"
                           Foreground="{DynamicResource SholtoTextMuted}" FontWeight="Bold" FontSize="11"
                           Margin="8,8" VerticalAlignment="Center"/>
            </Grid>

            <!-- Library-unreachable banner. Pops in when a music dir is saved but
                 the path doesn't exist on disk right now (typical cause: the
                 external drive that holds the user's library wasn't mounted at
                 app launch). Banner offers a "Choose folder…" button that runs
                 the same picker as the View menu's "Change Music Folder…" entry.
                 Sits in Row 1 so it overlays the empty track-list area; hidden
                 once a successful scan completes. -->
            <Border Grid.Row="1"
                    IsVisible="{Binding LibraryUnreachableVisible}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SholtoSurfaceRaised}"
                    BorderBrush="{DynamicResource SholtoBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="20,16" MaxWidth="520">
                <StackPanel Spacing="10">
                    <TextBlock Text="Music library not reachable"
                               Foreground="{DynamicResource SholtoAccent}"
                               FontWeight="Bold" FontSize="15"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding LibraryUnreachablePath}"
                               Foreground="{DynamicResource SholtoTextBright}"
                               FontFamily="monospace" FontSize="12"
                               TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    <TextBlock Text="The saved path doesn't exist right now — usually because an external drive hasn't mounted yet. Mount the drive and relaunch, or pick a different folder."
                               Foreground="{DynamicResource SholtoTextMuted}"
                               FontSize="12"
                               TextWrapping="Wrap" HorizontalAlignment="Center"
                               MaxWidth="460"/>
                    <Button Content="Choose folder…"
                            Click="OnMusicFolderClick"
                            HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <ListBox Grid.Row="1"
                     Name="TrackList"
                     ItemsSource="{Binding Tracks}"
                     SelectedIndex="{Binding SelectedTrackIndex, Mode=TwoWay}"
                     SelectionChanged="OnTrackSelectionChanged"
                     DoubleTapped="OnTrackDoubleTapped"
                     Background="{DynamicResource SholtoSurface}">
                <ListBox.Styles>
                    <!-- Override Fluent's hover/selected backgrounds so they don't clobber
                         our row foreground colors after the pointer leaves. -->
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource SholtoSurfaceRaised}"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource SholtoAccentBg}"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="80,50,240,*,80,80,80">
                            <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Done state — uses the theme accent so it reads as a positive
                                     signal and changes colour with each theme. -->
                                <TextBlock Text="✓"
                                           Foreground="{DynamicResource SholtoAccent}"
                                           FontSize="13" FontWeight="Bold"
                                           IsVisible="{Binding ShowAnalyzedCheck}"/>
                                <!-- Running state: indeterminate progress bar. Avalonia's
                                     built-in animation, no fragile custom animators.
                                     MinWidth=0 stops the default 100-px minimum from
                                     bleeding into the artist column. -->
                                <!-- IsIndeterminate is also bound — leaving it True
                                     keeps a hidden animation timer running on every
                                     hidden row (~90 of them at idle = catastrophic
                                     UI-thread invalidation). Only ticks when this row
                                     is actually analysing. -->
                                <ProgressBar Width="28" Height="4"
                                             MinWidth="0"
                                             IsIndeterminate="{Binding ShowAnalyzingSpinner}"
                                             ShowProgressText="False"
                                             HorizontalAlignment="Center"
                                             Background="Transparent"
                                             Foreground="{DynamicResource SholtoAccent}"
                                             IsVisible="{Binding ShowAnalyzingSpinner}"/>
                                <!-- Failed state — amber "!" where the tick would be.
                                     An analyser that died used to leave this cell blank,
                                     which reads identically to "not analysed yet". The
                                     tooltip carries the analyser's own error output. -->
                                <TextBlock Text="!"
                                           Foreground="{DynamicResource SholtoWarning}"
                                           FontSize="13" FontWeight="Bold"
                                           ToolTip.Tip="{Binding AnalysisFailureTooltip}"
                                           IsVisible="{Binding ShowAnalysisFailed}"/>
                            </Grid>
                            <Border Grid.Column="1"
                                    IsVisible="{Binding HasTags}"
                                    Background="{DynamicResource TagIndicatorBackground}"
                                    CornerRadius="3" Padding="6,1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    ToolTip.Tip="{Binding TagsTooltip}"
                                    PointerPressed="OnTagIndicatorPressed">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <TextBlock Text="🏷"
                                               Foreground="{DynamicResource TagIndicatorForeground}"
                                               FontSize="11"/>
                                    <TextBlock Text="{Binding TagCount}"
                                               Foreground="{DynamicResource TagIndicatorForeground}"
                                               FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <!-- Played tracks render italic. Style class applied to both
                                 artist and title cells so they shift together as one signal. -->
                            <!-- Artist is the secondary read — muted so Title anchors the row. -->
                            <TextBlock Grid.Column="2" Text="{Binding Artist}"
                                       Foreground="{DynamicResource SholtoTextMuted}"
                                       Margin="12,4" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Classes.played="{Binding IsPlayed}">
                                <TextBlock.Styles>
                                    <!-- Played = "spent": italic only, no added weight. -->
                                    <Style Selector="TextBlock.played">
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>
                            <!-- Title is the primary scan anchor — semibold + bright. -->
                            <TextBlock Grid.Column="3" Text="{Binding Title}"
                                       Foreground="{DynamicResource SholtoTextBright}"
                                       FontWeight="SemiBold"
                                       Margin="8,4" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Classes.played="{Binding IsPlayed}">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock.played">
                                        <Setter Property="FontStyle" Value="Italic"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SholtoTextMuted}"/>
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>
                            <TextBlock Grid.Column="4" Text="{Binding BpmDisplay}"
                                       Foreground="{DynamicResource SholtoAccent}"
                                       FontWeight="Bold" Margin="8,4" VerticalAlignment="Center"/>
                            <!-- Camelot key chip — matches the deck panel so the same colour
                                 shows in both surfaces. Hidden when no key is analysed yet.
                                 Chips for harmonically-eligible keys gain a primary-colour
                                 outline; non-eligible chips stay readable at full opacity. -->
                            <Border Grid.Column="5" CornerRadius="4" Padding="6,1"
                                    Background="{Binding KeyBrush}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="8,4"
                                    Classes="key-chip"
                                    Classes.eligible="{Binding KeyEligible}"
                                    IsVisible="{Binding Key, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <Border.Styles>
                                    <Style Selector="Border.key-chip">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
                                    </Style>
                                    <!-- Eligible chips get a bright white outline + soft white
                                         outer glow. Theme-bright outline instead of the theme's
                                         Primary so the "this key mixes" signal reads identically
                                         across every theme (Primary blends with similar-hue
                                         chip backgrounds in some themes). -->
                                    <Style Selector="Border.key-chip.eligible">
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource SholtoTextBright}"/>
                                        <Setter Property="BoxShadow" Value="{DynamicResource SholtoKeyChipGlow}"/>
                                    </Style>
                                </Border.Styles>
                                <TextBlock Text="{Binding Key}"
                                           Foreground="{DynamicResource SholtoKeyChipForeground}"
                                           FontWeight="Bold" FontSize="12"/>
                            </Border>
                            <TextBlock Grid.Column="6" Text="{Binding DurationDisplay}"
                                       Foreground="{DynamicResource SholtoTextMuted}"
                                       Margin="8,4" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Brand watermark + wooden-blinds texture overlay, both scale with the
             window. ClipToBounds keeps the rotated stripes inside the track-list
             area, IsHitTestVisible=False so nothing here steals clicks. -->
        <Grid Grid.Row="0" IsHitTestVisible="False" ClipToBounds="True">
            <!-- The S logo, scaled to fill ~60% of the track-list area via a
                 Viewbox + a Border that constrains aspect. Grows naturally as
                 the window resizes. -->
            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="40,40,40,60">
                <Grid Width="96" Height="96" Opacity="0.18">
                    <TextBlock Text="S" FontFamily="Inter, Helvetica, Arial" FontWeight="ExtraBold"
                               FontSize="84" Foreground="{DynamicResource SholtoStemDrums}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="-8,4,0,0"/>
                    <TextBlock Text="S" FontFamily="Inter, Helvetica, Arial" FontWeight="ExtraBold"
                               FontSize="84" Foreground="{DynamicResource SholtoStemVocals}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="S" FontFamily="Inter, Helvetica, Arial" FontWeight="ExtraBold"
                               FontSize="84" Foreground="{DynamicResource SholtoStemInstrumental}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="8,-4,0,0"/>
                </Grid>
            </Viewbox>

            <!-- Angled wooden-blinds texture, sits in front of the S at low
                 opacity for a venetian-blind feel. SpreadMethod=Repeat gives us
                 unlimited stripes; the RotateTransform tilts them ~22°. The
                 rectangle is oversized so the rotated corners still fill bounds. -->
            <Rectangle Width="3000" Height="3000" Opacity="0.03"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderTransformOrigin="50%,50%">
                <Rectangle.Fill>
                    <!-- Stripe period = 0.012 of the 3000 px rectangle = 36 px.
                         SpreadMethod=Repeat tiles the gradient outward. -->
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,1.2%"
                                         SpreadMethod="Repeat">
                        <GradientStop Color="{DynamicResource SholtoTextBrightColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource SholtoTextBrightColor}" Offset="0.35"/>
                        <GradientStop Color="Transparent" Offset="0.36"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="8"/>
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>

        <!-- Drop shadow cast by the top of Deck 1 onto the bottom of the track list.
             Lives in the list's row (0) but anchored to its bottom edge, so the
             gradient extends *into* the list. Dark at the bottom (where the deck
             meets the list), fading transparent upward. -->
        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="32"
                IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="Transparent" Offset="0.0"/>
                    <GradientStop Color="{DynamicResource SholtoShadowColor}" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <v:DeckView Grid.Row="2" DataContext="{Binding Deck1}"/>
        <v:DeckView Grid.Row="3" DataContext="{Binding Deck2}"/>

        <!-- Magnet-lock eligibility indicator. Sits in the gap between the two
             vinyl discs (left-aligned with horizontal margin matching the vinyl
             centre at x=90). Vertically centered across both deck rows so it
             lands exactly between the two vinyls.
             Pops in when both decks are analysed, both are playing, and their
             playback BPMs are within 0.5%. Animation: opacity 0→1 + scale
             0.4→1.0 with ease-out bounce. IsHitTestVisible=False so it never
             eats clicks meant for the deck. -->
        <Border Grid.Row="2" Grid.RowSpan="2"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                Margin="80,0,0,0"
                Width="20" Height="20"
                RenderTransformOrigin="50%,50%"
                IsHitTestVisible="False"
                Classes="magnet"
                Classes.eligible="{Binding IsMagnetEligible}">
            <Border.Styles>
                <Style Selector="Border.magnet">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="RenderTransform" Value="scale(0.4)"/>
                </Style>
                <Style Selector="Border.magnet.eligible">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="RenderTransform" Value="scale(1)"/>
                </Style>
            </Border.Styles>
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="BackEaseOut"/>
                </Transitions>
            </Border.Transitions>
            <!-- Material Design "link" icon at 24×24, scaled into the 40×40
                 viewbox via Viewbox/Stretch. Two interlocked C-shapes joined by
                 a horizontal bar — the universal "chain link / linked" glyph.
                 Drop shadow gives the green chip a little lift off the dark
                 backdrop so it pops against the waveform when active. -->
            <Viewbox Stretch="Uniform">
                <Canvas Width="24" Height="24">
                    <Path Fill="{DynamicResource SholtoStemVocals}"
                          Data="M 3.9 12 C 3.9 10.29 5.29 8.9 7 8.9 H 11 V 7 H 7 C 4.24 7 2 9.24 2 12 C 2 14.76 4.24 17 7 17 H 11 V 15.1 H 7 C 5.29 15.1 3.9 13.71 3.9 12 Z M 8 13 H 16 V 11 H 8 V 13 Z M 17 7 H 13 V 8.9 H 17 C 18.71 8.9 20.1 10.29 20.1 12 C 20.1 13.71 18.71 15.1 17 15.1 H 13 V 17 H 17 C 19.76 17 22 14.76 22 12 C 22 9.24 19.76 7 17 7 Z"/>
                </Canvas>
            </Viewbox>
        </Border>

    </Grid>
    </DockPanel>

    <!-- Spacebar search overlay. Sibling of DockPanel inside the top-level
         Grid so it z-orders ABOVE the entire app when its IsVisible flips on. -->
    <v:SearchOverlay/>
    <Panel x:Name="TagEditorHost" IsVisible="{Binding IsTagEditorOpen}">
        <!-- The view binds its own IsVisible to the host so its code-behind sees
             the change and focuses the input box (a child of a hidden parent
             never gets an IsVisible change of its own). -->
        <v:TagEditorView DataContext="{Binding TagEditor}"
                         IsVisible="{Binding #TagEditorHost.IsVisible}"/>
    </Panel>
    <!-- Controller guide overlay. Same hidden-parent trap as the tag editor above:
         the child binds its OWN IsVisible to the host rather than relying on the
         parent Panel's, so its code-behind actually sees the change. -->
    <cti:IconDockedContainer x:Name="FaceplateHost" Sequence="{Binding FaceplateDock}" Target="{Binding #FaceplateIcon}">
        <!-- Empty on purpose: the FaceplateOverlay needs a doc and a device layout, which
             XAML cannot supply, so the composition root builds it and MainWindow's
             constructor sets it as this container's content and binds its IsVisible to the
             container's. The container shows itself while the guide is open or shrinking
             into the top-bar icon. -->
    </cti:IconDockedContainer>
    <!-- Enter-mode action menu + add-to-crate picker. Above everything. -->
    <v:TrackActionsOverlay/>
    <modal:ModalShell Modal="{Binding CratePicker}" IsBodyFlush="True">
        <modal:ModalShell.Body><v:CratePickerOverlay/></modal:ModalShell.Body>
    </modal:ModalShell>

    <!-- What the amber status dot opens: which external tools are installed. -->
    <modal:ModalShell Modal="{Binding SystemReportModal}">
        <modal:ModalShell.Body><v:SystemReportOverlay/></modal:ModalShell.Body>
    </modal:ModalShell>

    <!-- Settings ▸ Layout Wizard…: step 1 picks the waveform style, previewed live on the decks. -->
    <modal:ModalShell Modal="{Binding LayoutWizard}">
        <modal:ModalShell.HeaderAccessory><v:LayoutWizardStepper/></modal:ModalShell.HeaderAccessory>
        <modal:ModalShell.Body><v:LayoutWizardOverlay/></modal:ModalShell.Body>
    </modal:ModalShell>
    <!-- Settings ▸ Settings…: the backspin time and distance knobs, applied live and saved by the App. -->
    <modal:ModalShell Modal="{Binding Settings}">
        <modal:ModalShell.Body><v:SettingsOverlay/></modal:ModalShell.Body>
    </modal:ModalShell>

    <!-- The load warning outside the overlay, so a controller LOAD onto a playing deck still shows it. -->
    <Border IsVisible="{Binding ShowLoadWarning}"
            HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Margin="24,0,24,90" Padding="16,10"
            Background="{DynamicResource SholtoStatusWarnTint}"
            BorderBrush="{DynamicResource SholtoStatusWarn}" BorderThickness="1"
            CornerRadius="6" IsHitTestVisible="False">
        <TextBlock Text="{Binding LoadFeedback.WarningText}" FontSize="14" TextWrapping="Wrap"
                   Foreground="{DynamicResource SholtoStatusWarn}"/>
    </Border>

    <!-- Brief bottom-centre toast (e.g. "Added to Warmup Set"). -->
    <Border IsVisible="{Binding HasToast}"
            HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Margin="0,0,0,40" Padding="18,10"
            Background="{DynamicResource SholtoSurfaceRaised}"
            BorderBrush="{DynamicResource SholtoAccent}" BorderThickness="1"
            CornerRadius="20" IsHitTestVisible="False">
        <TextBlock Text="{Binding Toast}" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource SholtoTextBright}"/>
    </Border>
    </Grid>
</Window>
