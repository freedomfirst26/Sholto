<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fp="using:Sholto.Faceplate.Views"
             x:Class="Sholto.Faceplate.Devices.DdjFlx4.DdjFlx4Layout">

  <!-- Pioneer DDJ-FLX4, drawn top-down in the reference render's own pixel space
       (1792 x 1316) so a coordinate measured off the unit is a coordinate typed
       here. A Viewbox scales the whole thing; nothing below needs to change.

       Every shape that a user can point at carries fp:ControlSurface.Id, and
       Deck 0 / 1 for the per-deck ones. Decorative shapes carry neither and are
       marked IsHitTestVisible="False" so they never swallow a hover from the
       shape underneath.

       A printed legend — the small silk-screened box above or below a button —
       instead carries fp:ControlSurface.HitFor, naming the control it belongs to.
       It is a hit PROXY, not a second shape: hovering or clicking it lights and
       selects that control, while the control's own body stays the thing that
       glows. Scaled into a window a 36px button is about 20 screen pixels and its
       legend is wider, so for several controls the label was the bigger target and
       the dead one — clicking the word SHIFT did nothing at all.

       A legend that names a control's SHIFT function (TEMPO RANGE under BEAT SYNC,
       DEL under CUE/LOOP CALL) still points at the button it sits on: that button
       is where the reader would look for it, and the panel lists shift gestures
       alongside plain ones.

       Legends deliberately left inert, because they name nothing the guide holds:
         IN ADJ, OUT ADJ         the loop IN and OUT buttons carry no Id at all
         BEAT LOOP, KEY SHIFT    likewise BEAT JUMP and SAMPLER pad-mode buttons
         LOOP                    a shared header straddling the gap between
                                 CUE/LOOP CALL's two arrows, aligned with neither

       Deck 2 is deck 1 TRANSLATED by +1074px, not mirrored: on the real unit the
       controls read IN, OUT, 4 BEAT/EXIT, CUE/LOOP CALL, BEAT SYNC left-to-right on
       both decks, so mirroring would reverse every label and run the EQ scales
       backwards (+6 ... -26). The channel strip translates by +135px. The LOAD
       buttons are the one genuine mirrored pair, because they flank the browse knob.

       The palette is deliberately fixed rather than themed: this is a picture of
       a physical object, and a graphite deck is graphite in every theme. See the
       UserControl.Resources block below: colours are named for their role. -->

  <UserControl.Resources>
    <Color x:Key="ShadowColor">#000000</Color>  <!-- drop shadows and recess wells -->
    <SolidColorBrush x:Key="Shadow" Color="{StaticResource ShadowColor}"/>
    <Color x:Key="HighlightColor">#FFFFFF</Color>  <!-- specular lips on dimples and bevels -->
    <SolidColorBrush x:Key="Highlight" Color="{StaticResource HighlightColor}"/>
    <Color x:Key="LabelInkColor">#D6DAE0</Color>  <!-- primary silk-screen text -->
    <SolidColorBrush x:Key="LabelInk" Color="{StaticResource LabelInkColor}"/>
    <Color x:Key="LabelInkDimColor">#9AA0A8</Color>  <!-- secondary scale text (-26, +6, MIN/MAX) -->
    <SolidColorBrush x:Key="LabelInkDim" Color="{StaticResource LabelInkDimColor}"/>
    <Color x:Key="LegendInkColor">#B9BDC4</Color>  <!-- text inside an outlined shift legend -->
    <SolidColorBrush x:Key="LegendInk" Color="{StaticResource LegendInkColor}"/>
    <Color x:Key="LegendFillColor">#1A1C1F</Color>  <!-- outlined legend box interior -->
    <SolidColorBrush x:Key="LegendFill" Color="{StaticResource LegendFillColor}"/>
    <Color x:Key="LegendEdgeColor">#7B7F86</Color>  <!-- outlined legend box border -->
    <SolidColorBrush x:Key="LegendEdge" Color="{StaticResource LegendEdgeColor}"/>
    <Color x:Key="AccentInkColor">#E8963C</Color>  <!-- orange silk-screen text -->
    <SolidColorBrush x:Key="AccentInk" Color="{StaticResource AccentInkColor}"/>
    <Color x:Key="AccentLitColor">#F0A24E</Color>  <!-- lit orange button lettering -->
    <SolidColorBrush x:Key="AccentLit" Color="{StaticResource AccentLitColor}"/>
    <Color x:Key="AccentEdgeColor">#C2661D</Color>  <!-- lit orange edge on pads and mode buttons -->
    <SolidColorBrush x:Key="AccentEdge" Color="{StaticResource AccentEdgeColor}"/>
    <Color x:Key="JogTickColor">#D3D8DE</Color>  <!-- the fine tick ring on the platter -->
    <SolidColorBrush x:Key="JogTick" Color="{StaticResource JogTickColor}"/>
    <Color x:Key="ScaleTickColor">#8F949B</Color>  <!-- fader scale ticks -->
    <SolidColorBrush x:Key="ScaleTick" Color="{StaticResource ScaleTickColor}"/>
    <Color x:Key="PointerInkColor">#DCE0E6</Color>  <!-- knob pointer line -->
    <SolidColorBrush x:Key="PointerInk" Color="{StaticResource PointerInkColor}"/>
    <Color x:Key="EdgeBlackColor">#0C0D0F</Color>  <!-- hardest body seam -->
    <Color x:Key="EdgeDarkColor">#0D0E10</Color>  <!-- cap and knob outlines -->
    <SolidColorBrush x:Key="EdgeDark" Color="{StaticResource EdgeDarkColor}"/>
    <Color x:Key="EdgeDarkAltColor">#0E0F11</Color>  <!-- knob cap outline -->
    <SolidColorBrush x:Key="EdgeDarkAlt" Color="{StaticResource EdgeDarkAltColor}"/>
    <Color x:Key="RimLightColor">#96999F</Color>  <!-- lit side of a knob rim -->
    <Color x:Key="RimMidColor">#4A4D53</Color>  <!-- knob rim, mid tone -->
    <Color x:Key="RimDarkColor">#17181B</Color>  <!-- knob rim, shaded side -->
    <Color x:Key="KnobSkirtLitColor">#63666B</Color>  <!-- knob skirt, lit -->
    <Color x:Key="KnobSkirtMidColor">#3A3D42</Color>  <!-- knob skirt, mid -->
    <Color x:Key="KnobSkirtDimColor">#212328</Color>  <!-- knob skirt, shaded -->
    <Color x:Key="KnobCapLitColor">#5A5D63</Color>  <!-- knob cap, lit -->
    <Color x:Key="KnobCapMidColor">#2E3136</Color>  <!-- knob cap, mid -->
    <Color x:Key="KnobCapDimColor">#17181C</Color>  <!-- knob cap, shaded -->
    <Color x:Key="ButtonTopColor">#4C5057</Color>  <!-- rounded button, lit edge -->
    <Color x:Key="ButtonFaceColor">#2A2C30</Color>  <!-- accent button face -->
    <Color x:Key="ButtonFaceDimColor">#171A1D</Color>  <!-- accent button face, shaded -->
    <Color x:Key="PadWarmColor">#33261B</Color>  <!-- pad rubber, warm lit corner -->
    <Color x:Key="PadFillColor">#191A1D</Color>  <!-- pad rubber, body -->
    <Color x:Key="CapDarkColor">#141619</Color>  <!-- fader cap, shaded end -->
  </UserControl.Resources>

  <Canvas Width="1792" Height="1316" Background="Transparent">
    <!-- Chassis. A single slab with a recessed centre panel; the drop shadow is what -->
    <!-- separates it from the backdrop it is drawn on. -->
    <Border Canvas.Left="88" Canvas.Top="204" Width="1616" Height="908" CornerRadius="20">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0.0" Color="#4A4D52"/>
          <GradientStop Offset="0.35" Color="#3B3E42"/>
          <GradientStop Offset="1.0" Color="#2C2E32"/>
        </LinearGradientBrush>
      </Border.Background>
      <Border.Effect>
        <DropShadowEffect Color="{StaticResource ShadowColor}" BlurRadius="34" OffsetX="0" OffsetY="8" Opacity="0.75"/>
      </Border.Effect>
    </Border>
    <Rectangle Canvas.Left="470" Canvas.Top="186" Width="26" Height="24" RadiusX="5" RadiusY="5" Fill="#191A1C" IsHitTestVisible="False"/>
    <Rectangle Canvas.Left="473" Canvas.Top="189" Width="20" Height="6" RadiusX="3" RadiusY="3" Fill="#4E5156" Opacity="0.55" IsHitTestVisible="False"/>
    <Rectangle Canvas.Left="508" Canvas.Top="186" Width="34" Height="24" RadiusX="5" RadiusY="5" Fill="#191A1C" IsHitTestVisible="False"/>
    <Rectangle Canvas.Left="511" Canvas.Top="189" Width="28" Height="6" RadiusX="3" RadiusY="3" Fill="#4E5156" Opacity="0.55" IsHitTestVisible="False"/>
    <Rectangle Canvas.Left="620" Canvas.Top="186" Width="30" Height="24" RadiusX="5" RadiusY="5" Fill="#191A1C" IsHitTestVisible="False"/>
    <Rectangle Canvas.Left="623" Canvas.Top="189" Width="24" Height="6" RadiusX="3" RadiusY="3" Fill="#4E5156" Opacity="0.55" IsHitTestVisible="False"/>
    <Rectangle Canvas.Left="664" Canvas.Top="186" Width="30" Height="24" RadiusX="5" RadiusY="5" Fill="#191A1C" IsHitTestVisible="False"/>
    <Rectangle Canvas.Left="667" Canvas.Top="189" Width="24" Height="6" RadiusX="3" RadiusY="3" Fill="#4E5156" Opacity="0.55" IsHitTestVisible="False"/>
    <Border Canvas.Left="630" Canvas.Top="204" Width="532" Height="908">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0.0" Color="#2B2D31"/>
          <GradientStop Offset="0.5" Color="#232529"/>
          <GradientStop Offset="1.0" Color="#1B1D20"/>
