    <Line StartPoint="626,204" EndPoint="626,1112" Stroke="#7A7E85" StrokeThickness="1.5" Opacity="0.45" IsHitTestVisible="False"/>
    <Rectangle Canvas.Left="1165" Canvas.Top="204" Width="6" Height="908" Fill="#08090A" IsHitTestVisible="False"/>
