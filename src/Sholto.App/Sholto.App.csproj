    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sholto.Data\Sholto.Data.csproj" />
    <ProjectReference Include="..\Sholto.App.Analysis\Sholto.App.Analysis.csproj" />
    <ProjectReference Include="..\Sholto.App.Audio\Sholto.App.Audio.csproj" />
    <ProjectReference Include="..\Sholto.App.Dsp\Sholto.App.Dsp.csproj" />
    <ProjectReference Include="..\Sholto.App.ExternalTools\Sholto.App.ExternalTools.csproj" />
    <ProjectReference Include="..\Sholto.App.Library\Sholto.App.Library.csproj" />
    <ProjectReference Include="..\Sholto.App.Settings\Sholto.App.Settings.csproj" />
    <ProjectReference Include="..\Sholto.App.Storage\Sholto.App.Storage.csproj" />
  </ItemGroup>
</Project>
