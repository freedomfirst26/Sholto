<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Sholto.App.Controls"
             xmlns:cvt="using:Sholto.App.Converters"
             x:Class="Sholto.App.Views.DeckView"
             x:Name="Root">

    <!-- Row 0 is Auto so the section-map strip reserves height only when the map is
         actually shown; while it's hidden (feature flag off / no segments) the row
         collapses to 0 and the deck reclaims the space. -->
    <Grid Background="{DynamicResource SholtoSurfaceRaised}" RowDefinitions="Auto,*">

        <Panel Grid.Row="1">
            <controls:WaveformControl x:Name="Waveform"
                                      GridEditMode="{Binding GridTuneActive}"
                                      Peaks="{Binding Peaks}"
                                      GridPeaks="{Binding GridPeaks}"
                                      VocalRegions="{Binding VocalRegions}"
                                      VocalsActive="{Binding VocalsActive}"
                                      MarkerSecs="{Binding MarkerSecs}"
                                      BeatTimes="{Binding BeatTimes}"
                                      DownbeatTimes="{Binding DownbeatTimes}"
                                      PlayPosition="{Binding PlayPosition}"
                                      PlaybackSpeed="{Binding PlaybackSpeed}"
                                      GainOverlay="{Binding EffectiveGain}"
                                      GainKnown="{Binding GainKnown}"
                                      GainOverlayColor="{Binding $parent[Window].DataContext.Theme.MintColor}"
                                      MagneticGlowSec="{Binding MagneticGlowSec}"
                                      IsScrubbing="{Binding IsScrubbing}"
                                      LoopStartSec="{Binding LoopStartSec}"
                                      LoopEndSec="{Binding LoopEndSec}"
                                      Palette="{Binding $parent[Window].DataContext.WaveformPalette}">
                <controls:WaveformControl.LoopColor>
                    <!-- Loop band turns red once the user has nudged this
                         deck's grid (IsGridNudged on the VM); otherwise
                         uses the theme's accent-derived band colour. -->
                    <MultiBinding Converter="{x:Static cvt:LoopColorConverter.Instance}">
                        <Binding Path="IsGridNudged"/>
                        <Binding Path="$parent[Window].DataContext.Theme.LoopBandColor"/>
                    </MultiBinding>
                </controls:WaveformControl.LoopColor>
            </controls:WaveformControl>

            <!-- Fade-to-background over the played half. -->
            <Border HorizontalAlignment="Left" Width="600" IsHitTestVisible="False"
                    Background="{Binding $parent[Window].DataContext.Theme.PlayedFadeGradient}"/>

            <!-- Mute tint: full-deck red wash whenever EffectiveGain is 0 (channel fader
                 fully down or crossfader fully on the other deck). Sits above the
                 waveform but below the disc/title cluster so the indicators stay legible. -->
            <Border IsHitTestVisible="False"
                    Background="#FF3D4E" Opacity="0.18"
                    IsVisible="{Binding IsMuted}"/>

            <!-- Disc + title cluster -->
            <!-- Disc + title cluster sits OVER the waveform. IsHitTestVisible was
                 previously false on this whole panel to let the waveform receive
                 pointer events, but the waveform has no click handlers and the
                 ÷2 / ×2 BPM buttons need to be clickable — so allow hit-test
                 here and let individual decorative children opt out below. -->
            <!-- INFO component: disc, BPM, title, key, stem chips. Reacts to the
                 deck's load state — dimmed (transparent) while Loading, full once
                 Loaded. The Waveform component above stays at full opacity. -->
            <StackPanel x:Name="Info"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="20,0,0,0" Spacing="16"
                        Opacity="{Binding InfoOpacity}">
                <StackPanel.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                    </Transitions>
                </StackPanel.Transitions>

                <StackPanel Orientation="Vertical" Spacing="6">
                <Grid Width="140" Height="140">
                    <!-- Outer ring: colour by progress, opacity flashes near the end
                         (DiscRingOpacity flips 1.0↔0.35 in sync with the controller LED
                         while the deck is Ending — one clock in the VM drives both). -->
                    <Border Name="DiscRing" Width="140" Height="140"
                            Opacity="{Binding DiscRingOpacity}">
                        <Ellipse Width="140" Height="140"
                                 Fill="{DynamicResource SholtoBgDeep}"
                                 Stroke="{Binding DiscRingBrush}"
                                 StrokeThickness="3"/>
                    </Border>
                    <Ellipse Width="124" Height="124" Stroke="{DynamicResource SholtoBorder}" StrokeThickness="1"/>
                    <Ellipse Width="108" Height="108" Stroke="{DynamicResource SholtoBorder}" StrokeThickness="1"/>
                    <Ellipse Width="92"  Height="92"  Stroke="{DynamicResource SholtoBorder}" StrokeThickness="1"/>

                    <!-- Needle (behind the album art so only the outer stub pokes out) -->
                    <Border Width="140" Height="140"
                            RenderTransformOrigin="0.5,0.5"
                            Background="Transparent">
                        <Border.RenderTransform>
                            <RotateTransform Angle="{Binding DiscAngle}" CenterX="70" CenterY="70"/>
                        </Border.RenderTransform>
                        <Rectangle Width="2" Height="60"
                                   Fill="{DynamicResource SholtoMint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Margin="0,10,0,0"/>
                    </Border>

                    <Ellipse Width="80" Height="80"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Fill="{Binding $parent[Window].DataContext.Theme.AlbumArtBrush}"/>

                    <!-- BPM trio centred over the album-art ellipse:
                           original (small, only when tempo-shifted)
                           current  (big main number)
                           range    (small, only when tempo-shifted)
                         Wrapped in a StackPanel so the three lines stay stacked
                         even though they sit inside the disc Grid. -->
                    <!-- BPM stack: main number gets a black drop-shadow halo for an
                         outline effect; smaller original + range numbers get a small
                         dark themed chip so they read against the album-art gradient. -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="2"
                                IsVisible="{Binding HasBpm}">
                        <StackPanel.Styles>
                            <!-- Side chips: collapsed (opacity 0 + squashed + nudged
                                 toward the centre) when not tempo-shifted, then ease
                                 outward into place when `shifted` class is set. -->
                            <Style Selector="Border.bpm-chip-top">
                                <Setter Property="Opacity" Value="0"/>
                                <Setter Property="RenderTransform" Value="scaleY(0.4) translateY(10px)"/>
                            </Style>
                            <Style Selector="Border.bpm-chip-top.shifted">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="RenderTransform" Value="scaleY(1) translateY(0px)"/>
                            </Style>
                            <Style Selector="Border.bpm-chip-bottom">
                                <Setter Property="Opacity" Value="0"/>
                                <Setter Property="RenderTransform" Value="scaleY(0.4) translateY(-10px)"/>
                            </Style>
                            <Style Selector="Border.bpm-chip-bottom.shifted">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="RenderTransform" Value="scaleY(1) translateY(0px)"/>
                            </Style>
                            <!-- Central number: briefly tilts + slight scale-down when
                                 the deck enters/exits shifted mode, then flattens. -->
                            <Style Selector="Border.bpm-chip-main">
                                <Setter Property="RenderTransform" Value="rotate(0deg) scale(1)"/>
                            </Style>
                            <Style Selector="Border.bpm-chip-main.shifted">
                                <Setter Property="RenderTransform" Value="rotate(0deg) scale(1)"/>
                            </Style>
                        </StackPanel.Styles>

                        <Border Classes="bpm-chip-top" Classes.shifted="{Binding ShowOriginalBpm}"
                                CornerRadius="6" Padding="6,1"
                                Background="{DynamicResource SholtoBgDeep}"
                                HorizontalAlignment="Center"
                                RenderTransformOrigin="50%,100%">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.35"/>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.45" Easing="CubicEaseInOut"/>
                                </Transitions>
                            </Border.Transitions>
                            <TextBlock Text="{Binding OriginalBpmShort}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SholtoTextBright}"
                                       Opacity="0.9"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Click the BPM to flip ½ / ×2: left-click halves (most madmom
                             errors are doubled; clicking halves brings it back to truth),
                             right-click doubles. Persisted to SQLite per track. -->
                        <Border Classes="bpm-chip-main" Classes.shifted="{Binding IsTempoShifted}"
                                CornerRadius="6" Padding="8,1"
                                Background="{DynamicResource SholtoBgDeep}"
                                HorizontalAlignment="Center"
                                RenderTransformOrigin="50%,50%"
                                Cursor="Hand"
                                ToolTip.Tip="Double / Halve BPM"
                                PointerPressed="OnBpmPressed">
                            <Border.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="CubicEaseOut"/>
                                </Transitions>
                            </Border.Transitions>
                            <TextBlock Text="{Binding BpmDisplayShort}"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource SholtoTextBright}"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <Border Classes="bpm-chip-bottom" Classes.shifted="{Binding ShowOriginalBpm}"
                                CornerRadius="6" Padding="6,1"
                                Background="{DynamicResource SholtoBgDeep}"
                                HorizontalAlignment="Center"
                                RenderTransformOrigin="50%,0%">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.35"/>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.45" Easing="CubicEaseInOut"/>
                                </Transitions>
                            </Border.Transitions>
                            <TextBlock Text="{Binding PitchRangeDisplay}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource SholtoAccent}"
                                       HorizontalAlignment="Center"/>
                        </Border>

                    </StackPanel>


                </Grid>

                <!-- Stem labels below the disc as right-leaning parallelogram chips.
                     Filled-color when the stem is active, hollow + colored text when muted.
                     Mirrors the arcs above; same color codes.
                     Hidden until Demucs stems are ready — the toggles do nothing
                     audibly without stems, so we don't show them as if they did. -->
                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center"
                            IsVisible="{Binding HasStems}">
                    <Grid Width="42" Height="16">
                        <Path Data="M 6 0 L 42 0 L 36 16 L 0 16 Z"
                              Fill="#3D8BFF" Stroke="#3D8BFF" StrokeThickness="1"
                              IsVisible="{Binding DrumsActive}"/>
                        <Path Data="M 6 0 L 42 0 L 36 16 L 0 16 Z"
                              Stroke="#3D8BFF" StrokeThickness="1"
                              IsVisible="{Binding !DrumsActive}"/>
                        <TextBlock Text="DRMS" FontSize="9" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="Black" IsVisible="{Binding DrumsActive}"/>
                        <TextBlock Text="DRMS" FontSize="9" FontWeight="Bold" Opacity="0.7"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#3D8BFF" IsVisible="{Binding !DrumsActive}"/>
                    </Grid>
                    <Grid Width="42" Height="16">
                        <Path Data="M 6 0 L 42 0 L 36 16 L 0 16 Z"
                              Fill="#34F06F" Stroke="#34F06F" StrokeThickness="1"
                              IsVisible="{Binding VocalsActive}"/>
                        <Path Data="M 6 0 L 42 0 L 36 16 L 0 16 Z"
                              Stroke="#34F06F" StrokeThickness="1"
                              IsVisible="{Binding !VocalsActive}"/>
                        <TextBlock Text="VOX" FontSize="9" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="Black" IsVisible="{Binding VocalsActive}"/>
                        <TextBlock Text="VOX" FontSize="9" FontWeight="Bold" Opacity="0.7"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#34F06F" IsVisible="{Binding !VocalsActive}"/>
                    </Grid>
                    <Grid Width="42" Height="16">
                        <Path Data="M 6 0 L 42 0 L 36 16 L 0 16 Z"
                              Fill="#FF4E5E" Stroke="#FF4E5E" StrokeThickness="1"
                              IsVisible="{Binding InstrumentalActive}"/>
                        <Path Data="M 6 0 L 42 0 L 36 16 L 0 16 Z"
                              Stroke="#FF4E5E" StrokeThickness="1"
                              IsVisible="{Binding !InstrumentalActive}"/>
                        <TextBlock Text="INST" FontSize="9" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="Black" IsVisible="{Binding InstrumentalActive}"/>
                        <TextBlock Text="INST" FontSize="9" FontWeight="Bold" Opacity="0.7"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#FF4E5E" IsVisible="{Binding !InstrumentalActive}"/>
                    </Grid>
                </StackPanel>
                </StackPanel>

                <StackPanel VerticalAlignment="Center" Spacing="4" MaxWidth="320">
                    <TextBlock Text="{Binding LoadedTrack.Title, FallbackValue=''}"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource SholtoTextBright}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding LoadedTrack.Artist, FallbackValue=''}"
                               FontSize="14"
                               Foreground="{DynamicResource SholtoTextMuted}"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- Camelot key chip — Camelot-coloured background so the
                         same hue shows here and in the library row. Hidden until
                         KeyAnalysis lands. Dark text on the saturated chip stays
                         legible across the whole 24-key palette. -->
                    <Border CornerRadius="6" Padding="8,2"
                            Background="{Binding KeyBrush}"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,0"
                            IsVisible="{Binding HasKey}">
                        <TextBlock Text="{Binding Camelot}"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="White"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Click-away backdrop: covers the deck while the tune editor is open so
                 a click anywhere outside it dismisses. Transparent = still hit-testable. -->
            <Border Background="Transparent"
                    IsVisible="{Binding EditOpen}"
                    PointerPressed="OnEditBackdropPressed"/>

            <!-- Combined tune editor: slides in from the left over the disc when the
                 BPM is clicked. ↑↓ = BPM, ←→ = grid nudge (buttons mirror the keys);
                 ½ halves/restores; ⟲ resets to the analysed detection; × closes.
                 Lifted to the deck panel (not the 140px disc) so it has room and can't
                 be clipped; theme-accent outline follows the live theme. -->
            <Border x:Name="TuneEditor"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="14,0,0,0"
                    Height="44" MinWidth="250"
                    CornerRadius="22" Padding="8,0"
                    Background="{DynamicResource SholtoSurfaceRaised}"
                    BorderBrush="{DynamicResource SholtoAccent}" BorderThickness="1.5"
                    BoxShadow="0 6 20 0 #A0000000"
                    RenderTransformOrigin="0%,50%"
                    Classes.open="{Binding EditOpen}">
                <Border.Styles>
                    <Style Selector="Border#TuneEditor">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                        <Setter Property="RenderTransform" Value="translateX(-24px)"/>
                    </Style>
                    <Style Selector="Border#TuneEditor.open">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="IsHitTestVisible" Value="True"/>
                        <Setter Property="RenderTransform" Value="translateX(0px)"/>
                    </Style>
                    <Style Selector="Button.tune">
                        <Setter Property="Width" Value="30"/>
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="CornerRadius" Value="15"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="{DynamicResource SholtoTextBright}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                    <Style Selector="Button.tune:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource SholtoAccentBg}"/>
                    </Style>
                    <Style Selector="Button.tune PathIcon">
                        <Setter Property="Width" Value="16"/>
                        <Setter Property="Height" Value="16"/>
                    </Style>
                    <Style Selector="Button.stepper">
                        <Setter Property="Width" Value="22"/>
                        <Setter Property="Height" Value="18"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="CornerRadius" Value="5"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="{DynamicResource SholtoTextBright}"/>
                    </Style>
                    <Style Selector="Button.stepper:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource SholtoAccentBg}"/>
                    </Style>
                    <Style Selector="Button.stepper PathIcon">
                        <Setter Property="Width" Value="15"/>
                        <Setter Property="Height" Value="15"/>
                    </Style>
                    <Style Selector="Border.divider">
                        <Setter Property="Width" Value="1"/>
                        <Setter Property="Height" Value="24"/>
                        <Setter Property="Margin" Value="5,0"/>
                        <Setter Property="Background" Value="{DynamicResource SholtoBorder}"/>
                    </Style>
                </Border.Styles>
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.16"/>
                        <TransformOperationsTransition Property="RenderTransform"
                                                       Duration="0:0:0.22" Easing="CubicEaseOut"/>
                    </Transitions>
                </Border.Transitions>

                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <!-- ½ halve / restore -->
                    <Button Classes="tune" Tag="half" Click="OnTuneAction" ToolTip.Tip="Halve / restore tempo">
                        <TextBlock Text="½" FontSize="18" FontWeight="Bold"/>
                    </Button>

                    <Border Classes="divider"/>

                    <!-- BPM: ↑ / ↓ around the live value -->
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Spacing="0">
                        <Button Classes="stepper" Tag="bpm+" Click="OnTuneAction" ToolTip.Tip="BPM +0.1 (↑)">
                            <PathIcon Data="m12 10.8l-4.6 4.6L6 14l6-6l6 6l-1.4 1.4z"/>
                        </Button>
                        <Button Classes="stepper" Tag="bpm-" Click="OnTuneAction" ToolTip.Tip="BPM −0.1 (↓)">
                            <PathIcon Data="m12 15.4l-6-6L7.4 8l4.6 4.6L16.6 8L18 9.4z"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding BpmDisplayShort}" MinWidth="46"
                               FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource SholtoTextBright}"
                               VerticalAlignment="Center" TextAlignment="Center"/>

                    <Border Classes="divider"/>

                    <!-- GRID: ← / → nudge -->
                    <Button Classes="tune" Tag="phase-" Click="OnTuneAction" ToolTip.Tip="Nudge grid earlier (←)">
                        <PathIcon Data="m14 18l-6-6l6-6l1.4 1.4l-4.6 4.6l4.6 4.6z"/>
                    </Button>
                    <Button Classes="tune" Tag="phase+" Click="OnTuneAction" ToolTip.Tip="Nudge grid later (→)">
                        <PathIcon Data="M12.6 12L8 7.4L9.4 6l6 6l-6 6L8 16.6z"/>
                    </Button>

                    <Border Classes="divider"/>

                    <!-- reset to analysis + close -->
                    <Button Classes="tune" Tag="reset" Click="OnTuneAction" ToolTip.Tip="Reset tempo &amp; grid to analysis">
                        <PathIcon Data="M11 20.95q-3.025-.375-5.012-2.637T4 13q0-1.65.65-3.162T6.5 7.2l1.425 1.425q-.95.85-1.437 1.975T6 13q0 2.2 1.4 3.888T11 18.95zm2 0v-2q2.175-.4 3.588-2.075T18 13q0-2.5-1.75-4.25T12 7h-.075l1.1 1.1l-1.4 1.4l-3.5-3.5l3.5-3.5l1.4 1.4l-1.1 1.1H12q3.35 0 5.675 2.325T20 13q0 3.025-1.987 5.288T13 20.95"/>
                    </Button>
                    <Button Classes="tune" Tag="close" Click="OnTuneAction" ToolTip.Tip="Close (Esc)">
                        <PathIcon Data="M6.4 19L5 17.6l5.6-5.6L5 6.4L6.4 5l5.6 5.6L17.6 5L19 6.4L13.4 12l5.6 5.6l-1.4 1.4l-5.6-5.6z"/>
                    </Button>
                </StackPanel>
            </Border>
        </Panel>

        <!-- Stationary whole-song section map in its own top row. Declared LAST so it
             wins z-order over the waveform panel (Grid does not clip cells and later
             siblings paint on top). Hidden until segments exist. -->
        <Panel Grid.Row="0">
            <controls:MinimapControl x:Name="Minimap"
                                     IsVisible="{Binding SectionMapVisible}"
                                     Peaks="{Binding GridPeaks}"
                                     Segments="{Binding Segments}"
                                     PlayPosition="{Binding PlayPosition}"/>
        </Panel>
    </Grid>
</UserControl>
