<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sholto.App.ViewModels"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="Sholto.App.Views.SearchOverlay"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding IsSearchOpen}"
             Focusable="False">

    <!-- Full-screen backdrop dims everything behind the panel. Click anywhere
         outside the panel to close (handler in code-behind). -->
    <Grid Background="#A0000000" PointerPressed="OnBackdropPressed">

        <!-- Centred panel. 60% of window width, 70% of window height max. -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="720" MaxHeight="600"
                Background="{DynamicResource SholtoSurfaceRaised}"
                BorderBrush="{DynamicResource SholtoBorder}" BorderThickness="1"
                CornerRadius="8" Padding="0"
                PointerPressed="OnPanelPressed">

            <Grid RowDefinitions="Auto,Auto,*" Margin="0">
                <!-- Deck-target chooser above the input. Two circles labelled
                     1 and 2; ←/→ in the input toggles which is highlighted,
                     Enter loads into the highlighted deck. Default is picked
                     when the overlay opens — see MainViewModel.PickDefaultLoadTarget.
                     Colours come from the live theme via Window.DataContext
                     so the chip retones along with the rest of the UI. -->
                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="12" Margin="0,14,0,10">
                    <!-- Label so the two circles read as "which deck to load into",
                         not page numbers. -->
                    <TextBlock Text="LOAD TO" FontSize="11" FontWeight="Bold"
                               LetterSpacing="1.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource SholtoTextMuted}"/>
                    <StackPanel.Styles>
                        <Style Selector="Border.deckChip">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="Border.deckChip.active">
                            <Setter Property="Background"
                                    Value="{Binding $parent[Window].DataContext.Theme.Accent}"/>
                        </Style>
                        <Style Selector="Border.deckChip TextBlock">
                            <Setter Property="Foreground"
                                    Value="{Binding $parent[Window].DataContext.Theme.Accent}"/>
                        </Style>
                        <Style Selector="Border.deckChip.active TextBlock">
                            <Setter Property="Foreground"
                                    Value="{Binding $parent[Window].DataContext.Theme.SurfaceRaised}"/>
                        </Style>
                    </StackPanel.Styles>
                    <Border Classes="deckChip" Classes.active="{Binding IsLoadTargetDeck1}"
                            Width="36" Height="36" CornerRadius="18"
                            BorderThickness="2"
                            BorderBrush="{Binding $parent[Window].DataContext.Theme.Accent}">
                        <TextBlock Text="1" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Classes="deckChip" Classes.active="{Binding IsLoadTargetDeck2}"
                            Width="36" Height="36" CornerRadius="18"
                            BorderThickness="2"
                            BorderBrush="{Binding $parent[Window].DataContext.Theme.Accent}">
                        <TextBlock Text="2" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Search identity: magnifier icon left of the big input. -->
                <TextBlock Grid.Row="1" Text="🔍" FontSize="20"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="20,0,0,0" IsHitTestVisible="False"/>
                <!-- Big search input -->
                <TextBox x:Name="QueryBox"
                         Grid.Row="1"
                         Text="{Binding Search.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Watermark="Search tracks or crates…"
                         FontSize="24" Padding="54,16,20,16"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource SholtoTextBright}"
                         KeyDown="OnQueryKeyDown"/>

                <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1"
                        Background="{DynamicResource SholtoBorder}"/>

                <!-- Filtered results + tag bucket -->
                <ScrollViewer Grid.Row="2">
                    <StackPanel>
                        <!-- CRATES section — matches crate names; click to filter the
                             library to that crate. Grouped above the tracks. -->
                        <TextBlock Text="📦  CRATES"
                                   Foreground="{DynamicResource SholtoTextMuted}"
                                   FontWeight="Bold" FontSize="11" LetterSpacing="1"
                                   Margin="20,10,20,4"
                                   IsVisible="{Binding Search.CrateHits.Count}"/>
                        <ItemsControl ItemsSource="{Binding Search.CrateHits}" Padding="0,0,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" Cursor="Hand"
                                            PointerPressed="OnCrateRowPressed" Tag="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,5">
                                            <TextBlock Grid.Column="0" Text="📦" FontSize="15"
                                                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SholtoTextBright}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TrackCount}"
                                                       Foreground="{DynamicResource SholtoTextMuted}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="🎵  TRACKS"
                                   Foreground="{DynamicResource SholtoTextMuted}"
                                   FontWeight="Bold" FontSize="11" LetterSpacing="1"
                                   Margin="20,6,20,4"
                                   IsVisible="{Binding Search.Results.Count}"/>
                        <ListBox x:Name="ResultsList"
                                 ItemsSource="{Binding Search.Results}"
                                 SelectedIndex="{Binding Search.SelectedIndex, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Focusable="False"
                                 Padding="0,4">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TrackRow">
                                    <Grid ColumnDefinitions="*,Auto,60" Margin="12,4">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding Artist}" FontWeight="Bold"
                                                       Foreground="{DynamicResource SholtoTextBright}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="—" Foreground="{DynamicResource SholtoTextMuted}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{DynamicResource SholtoTextBright}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding BpmDisplay}"
                                                   Foreground="{DynamicResource SholtoAccent}"
                                                   Margin="12,0" VerticalAlignment="Center"/>
                                        <!-- Camelot chip. Bound to Key (not Camelot — that property
                                             name doesn't exist on TrackRow; the field is called Key
                                             because some tracks have a non-Camelot key string too).
                                             Hidden when the track hasn't been analysed yet so the
                                             chip area collapses cleanly. -->
                                        <Border Grid.Column="2" Background="{Binding KeyBrush}"
                                                CornerRadius="3" Padding="6,2"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                IsVisible="{Binding Key, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="{Binding Key}" FontSize="11" FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="TAGS"
                                   Foreground="{DynamicResource SholtoTextMuted}"
                                   FontWeight="Bold" FontSize="11"
                                   Margin="20,12,20,4"
                                   IsVisible="{Binding Search.TagHits.Count}"/>

                        <ItemsControl ItemsSource="{Binding Search.TagHits}" Padding="12,0,12,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource TagChipBackground}"
                                            CornerRadius="3" Padding="8,3"
                                            Margin="6,2"
                                            Cursor="Hand"
                                            PointerPressed="OnTagChipPressed"
                                            Tag="{Binding Name}">
                                        <TextBlock Foreground="{DynamicResource TagChipForeground}"
                                                   FontSize="12">
                                            <Run Text="{Binding Name}"/>
                                            <Run Text=" ("/><Run Text="{Binding TrackCount}"/><Run Text=")"/>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
